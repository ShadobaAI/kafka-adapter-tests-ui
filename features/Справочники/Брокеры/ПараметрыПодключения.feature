		| 'client.id' | 'VA-клиент' | 'Нет' |
		| 'socket.timeout.ms' | '500' | 'Нет' |
		| 'socket.keepalive.enable' | 'true' | 'Нет' |
		| 'security.protocol' | 'ssl' | 'Нет' |
