@tree
@СлужебныеРегистры
@ИсходящиеСообщения

Функциональность: Исходящие сообщения (Kafka) - Удаление и групповые команды
# Менеджер и TestClient используют одну ИБ. Общие настройки не меняются.
# Собственные ключи и UUID выводятся до первой записи; после успеха данные удаляются через список.
# При сбое очистить только выведенные собственные ключи теми же командами списка.
# Две записи имеют один КлючЗаписи и разные метки: проверяется полный состав ключа сообщения.
# При сбое удалить только собственные ключи через отбор и команды списка; общие данные не очищать.
# Клиенты остаются открытыми. Код добавляет и изменяет fixtures: формы регистров не разрешают запись.
# Поля проверяются в карточках, удаление сообщений выполняется кнопками списка с подтверждением.
# Проверяемые прикладные команды выполняются в TestClient соответствующего пользователя.

Контекст:
	Дано Я подключаю клиент тестирования с параметрами:
		| 'Имя' | 'Логин' | 'Имя компьютера' | 'Дополнительные параметры строки запуска' |
		| 'АдминистраторKafka' | 'АдминистраторKafka' | 'localhost' | '/iTaxi' |
	И Я запоминаю значение выражения 'Строка(Новый УникальныйИдентификатор)' в переменную "ИдентификаторДанных"
	И Я запоминаю значение выражения '"VA-" + Контекст.ИдентификаторДанных' в переменную "КлючЗаписи"
	И Я запоминаю значение выражения 'Контекст.КлючЗаписи + "-3"' в переменную "КлючКонтроля"
	И Я запоминаю значение выражения 'Контекст.КлючЗаписи' в переменную "ИмяДанных"
	И я вывожу значение переменной "КлючЗаписи"
	И я вывожу значение переменной "КлючКонтроля"
	И я вывожу значение переменной "ИдентификаторДанных"
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Если кфкФоновыеОперацииСлужебный.РегламентноеЗадание().Использование
			И Не ПолучитьФункциональнуюОпцию("кфкБлокировкаИнтеграции") Тогда
			ВызватьИсключение "Перед тестом остановите фоновый обмен Kafka.";
		КонецЕсли;
		Если кфкФоновыеОперацииСлужебный.ПолучитьПотоки(СостояниеФоновогоЗадания.Активно).Количество() > 0 Тогда
			ВызватьИсключение "Перед тестом дождитесь завершения фоновых потоков Kafka.";
		КонецЕсли;
		Метка = кфкОбщегоНазначенияСлужебный.НоваяКомбинированнаяМетка();
		МеткаВторая = кфкОбщегоНазначенияСлужебный.НоваяКомбинированнаяМетка();
		Объект.ЗначениеНаСервере = Формат(Метка, "ЧГ=0;ЧН=0") + "|" + Формат(МеткаВторая, "ЧГ=0;ЧН=0");
		"""
	И я выполняю код встроенного языка
		"""bsl
		Метки = СтрРазделить(Ванесса.Объект.ЗначениеНаСервере, "|");
		Контекст.Вставить("МеткаЗаписи", Метки[0]);
		Контекст.Вставить("МеткаВторая", Метки[1]);
		Контекст.Вставить("МеткаЗаписиВФорме", Формат(Число(Метки[0]), "ЧГ=3,0;ЧДЦ=0"));
		Контекст.Вставить("МеткаВтораяВФорме", Формат(Число(Метки[1]), "ЧГ=3,0;ЧДЦ=0"));
		"""

Структура сценария: Удаление выделенных сообщений не затрагивает другую метку того же ключа

	И Я запоминаю значение выражения <ВыражениеОтвета> в переменную "Ответ"
	И Я запоминаю значение выражения <ВыражениеСохранения> в переменную "Сохранить"
	И Я запоминаю значение выражения '?(Контекст.Сохранить = "Истина", 2, 1)' в переменную "КоличествоПослеКоманды"
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Настройка = кфк_т_ТестовыеДанные.СсылкаПродюсераОбщий();
		Для НомерЗаписи = 1 По 3 Цикл
			Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
			Запись.КлючЗаписи = ?(НомерЗаписи = 3, "$КлючКонтроля$", "$КлючЗаписи$");
			Запись.МеткаРегистрации = Число(?(НомерЗаписи = 2, "$МеткаВторая$", "$МеткаЗаписи$"));
			Запись.МеткаИзменения = Запись.МеткаРегистрации;
			Запись.Статус = Перечисления.кфкСтатусыСообщений.ОшибкаОбработки;
			Запись.Продюсер = Настройка;
			Запись.КлючСообщения = "$КлючЗаписи$-" + Формат(НомерЗаписи, "ЧГ=0");
			Запись.КоличествоОбработок = 3;
			Запись.ДатаОбработки = Дата(2026, 1, 1, 10, 0, 2);
			Запись.ДлОбработкиМС = 125;
			Запись.ТипОбъект = "Справочник.кфк_т_ТестовыйСправочник";
			Запись.ТипИсходныхДанных = "Структура";
			Запись.КлючОбъекта = "$ИдентификаторДанных$";
			Запись.ДатаРегистрации = Дата(2026, 1, 1, 10, 0, НомерЗаписи);
			Запись.КоличествоВыгрузок = 2;
			Запись.ДатаВыгрузки = Дата(2026, 1, 1, 10, 0, 3);
			Запись.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(
				Новый Структура("Маркер", Запись.КлючСообщения));
			Заголовки = Новый Соответствие;
			Заголовки.Вставить("va-marker", Запись.КлючСообщения);
			Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Заголовки);
			Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(
				"{""marker"":""" + Запись.КлючСообщения + """}");
			Запись.ТекстЖурнала = "VA: исходный журнал";
			Запись.Записать();
		КонецЦикла;
		"""
