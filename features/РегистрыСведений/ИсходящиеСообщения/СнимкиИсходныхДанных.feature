Сценарий: Снимок записи тестового регистра показывает измерения ресурс и отсутствие живой записи

	Попытка
		И Я подготавливаю тестовые исходящие сообщения Kafka "$КлючЗаписи$" "$МеткаЗаписи$" "$МеткаВторая$" "$ИдентификаторДанных$" "Обработано"
		И я выполняю код встроенного языка на сервере с передачей переменных
			"""bsl
			Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
			Запись.КлючЗаписи = "$КлючЗаписи$";
			Запись.МеткаРегистрации = Число("$МеткаЗаписи$");
			Запись.Прочитать();
			Запись.ТипОбъект = "РегистрСведений.кфк_т_ТестовыйРегистрСведений";
			Запись.ТипИсходныхДанных = "InformationRegisterRecordSet.кфк_т_ТестовыйРегистрСведений";
			Снимок = Новый Структура;
			Снимок.Вставить("ТестоваяСсылка", Справочники.кфк_т_ТестовыйСправочник.ПолучитьСсылку(Новый УникальныйИдентификатор("$ИдентификаторДанных$")));
			Снимок.Вставить("Булево", Истина);
			Снимок.Вставить("Строка", "$КлючЗаписи$");
