			Данные.Булево = Истина;
			Данные.ДатаИВремя = Дата(2026, 1, 1, 10, 0, 0);
			Данные.Комментарий = "VA: собственные данные";
			Данные.Перечисление = Перечисления.кфк_т_ТестовоеПеречисление[0];
			кфкИнтеграция.Отключить(Данные);
			Данные.ОбменДанными.Загрузка = Истина;
			Данные.Записать();
