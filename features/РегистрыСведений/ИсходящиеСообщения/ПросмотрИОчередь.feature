Сценарий: Пустые заголовки и журнал не доступны для просмотра

	Попытка
		И я выполняю код встроенного языка на сервере с передачей переменных
			"""bsl
			Настройка = кфк_т_ТестовыеДанные.СсылкаПродюсераОбщий();
			Для НомерЗаписи = 1 По 3 Цикл
				Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
				Запись.КлючЗаписи = ?(НомерЗаписи = 3, "$КлючКонтроля$", "$КлючЗаписи$");
				Запись.МеткаРегистрации = Число(?(НомерЗаписи = 2, "$МеткаВторая$", "$МеткаЗаписи$"));
				Запись.МеткаИзменения = Запись.МеткаРегистрации;
				Запись.Статус = Перечисления.кфкСтатусыСообщений.Обработано;
				Запись.Продюсер = Настройка;
				Запись.КлючСообщения = "$КлючЗаписи$-" + Формат(НомерЗаписи, "ЧГ=0");
				Запись.КоличествоОбработок = 3;
				Запись.ДатаОбработки = Дата(2026, 1, 1, 10, 0, 2);
				Запись.ДлОбработкиМС = 125;
				Запись.ТипОбъект = "Справочник.кфк_т_ТестовыйСправочник";
				Запись.ТипИсходныхДанных = "Структура";
				Запись.КлючОбъекта = "$ИдентификаторДанных$";
				Запись.ДатаРегистрации = Дата(2026, 1, 1, 10, 0, НомерЗаписи);
				Запись.КоличествоВыгрузок = 2;
				Запись.ДатаВыгрузки = Дата(2026, 1, 1, 10, 0, 3);
				Запись.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(
					Новый Структура("Маркер", Запись.КлючСообщения));
				Заголовки = Новый Соответствие;
				Заголовки.Вставить("va-marker", Запись.КлючСообщения);
				Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Заголовки);
				Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(
					"{""marker"":""" + Запись.КлючСообщения + """}");
				Запись.ТекстЖурнала = "VA: исходный журнал";
				Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Новый Соответствие);
				Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище("");
				Запись.ТекстЖурнала = "";
				Запись.ИсходныеДанные = Новый ХранилищеЗначения("");
				Запись.Записать();
			КонецЦикла;
			"""
		Дано Я подключаю клиент тестирования с параметрами:
			| 'Имя' | 'Логин' | 'Имя компьютера' | 'Дополнительные параметры строки запуска' |
			| 'АдминистраторKafka' | 'АдминистраторKafka' | 'localhost' | '/iTaxi' |
		И я читаю данные текущего профиля клиента тестирования
		Тогда переменная "ИмяКлиентаТестирования" имеет значение "АдминистраторKafka"
		И переменная "ДопПараметрыКлиентаТестирования" имеет значение '*/N"АдминистраторKafka"*' по шаблону
		И переменная "ДопПараметрыКлиентаТестирования" имеет значение "*/iTaxi*" по шаблону
		И Я закрыл все окна клиентского приложения
		И я включаю проверку видимости элементов с учётом видимости групп элементов
		И Я открываю навигационную ссылку "e1cib/list/РегистрСведений.кфкИсходящиеСообщения"
		Тогда открылась форма с именем "РегистрСведений.кфкИсходящиеСообщения.Форма.ФормаСписка"
		И Я очищаю фильтр на форме списка
		И в таблице "Список" я перехожу к строке
			| 'Ключ объекта' | 'Дата регистрации' |
			| '$ИдентификаторДанных$' | '01.01.2026 10:00:01' |
		И в таблице "Список" я выбираю текущую строку
		Тогда открылась форма с именем "РегистрСведений.кфкИсходящиеСообщения.Форма.ФормаЗаписи"
		И элемент формы с именем "СтраницаЗаголовки" не доступен
		И элемент формы с именем "СтраницаТекстЖурнала" не доступен
		И элемент формы с именем "СтраницаТелоСообщения" не доступен
		И элемент формы с именем "СтраницаИсходныеДанные" не доступен
	Исключение
		И я регистрирую ошибку "Ошибка сценария сообщений Kafka" по данным исключения
	И Я удаляю тестовые сообщения Kafka "кфкИсходящиеСообщения" "$ИдентификаторДанных$" "$КлючЗаписи$"

Структура сценария: Возврат выделенного сообщения в очередь обновляет статус в списке

	Попытка
		И Я запоминаю значение выражения <ВыражениеИсходныйСтатус> в переменную "ИсходныйСтатус"
		И Я запоминаю значение выражения <ВыражениеПредставлениеСтатуса> в переменную "ПредставлениеСтатуса"
		И я выполняю код встроенного языка на сервере с передачей переменных
			"""bsl
			Настройка = кфк_т_ТестовыеДанные.СсылкаПродюсераОбщий();
			Для НомерЗаписи = 1 По 3 Цикл
				Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
				Запись.КлючЗаписи = ?(НомерЗаписи = 3, "$КлючКонтроля$", "$КлючЗаписи$");
				Запись.МеткаРегистрации = Число(?(НомерЗаписи = 2, "$МеткаВторая$", "$МеткаЗаписи$"));
				Запись.МеткаИзменения = Запись.МеткаРегистрации;
				Запись.Статус = Перечисления.кфкСтатусыСообщений.$ИсходныйСтатус$;
				Запись.Продюсер = Настройка;
				Запись.КлючСообщения = "$КлючЗаписи$-" + Формат(НомерЗаписи, "ЧГ=0");
				Запись.КоличествоОбработок = 3;
				Запись.ДатаОбработки = Дата(2026, 1, 1, 10, 0, 2);
				Запись.ДлОбработкиМС = 125;
				Запись.ТипОбъект = "Справочник.кфк_т_ТестовыйСправочник";
				Запись.ТипИсходныхДанных = "Структура";
				Запись.КлючОбъекта = "$ИдентификаторДанных$";
				Запись.ДатаРегистрации = Дата(2026, 1, 1, 10, 0, НомерЗаписи);
				Запись.КоличествоВыгрузок = 2;
				Запись.ДатаВыгрузки = Дата(2026, 1, 1, 10, 0, 3);
				Запись.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(
					Новый Структура("Маркер", Запись.КлючСообщения));
				Заголовки = Новый Соответствие;
				Заголовки.Вставить("va-marker", Запись.КлючСообщения);
				Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Заголовки);
				Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(
					"{""marker"":""" + Запись.КлючСообщения + """}");
