#language: ru

@tree
@СлужебныеРегистры
@ИсходящиеСообщения

Функциональность: Исходящие сообщения (Kafka) - Представление комбинированных меток
# Менеджер и TestClient используют одну ИБ. Общие настройки не меняются.
# Собственные ключи и UUID выводятся до первой записи; после успеха данные удаляются через список.
# При сбое очистить только выведенные собственные ключи теми же командами списка.
# Две записи имеют один КлючЗаписи и разные метки: проверяется полный состав ключа сообщения.
# При сбое удалить только собственные ключи через отбор и команды списка; общие данные не очищать.
# Клиенты остаются открытыми. Код добавляет и изменяет fixtures: формы регистров не разрешают запись.
# Поля проверяются в карточках, удаление сообщений выполняется кнопками списка с подтверждением.
# Проверяемые прикладные команды выполняются в TestClient соответствующего пользователя.

Контекст:
	Дано Я подключаю клиент тестирования с параметрами:
		| 'Имя' | 'Логин' | 'Имя компьютера' | 'Дополнительные параметры строки запуска' |
		| 'АдминистраторKafka' | 'АдминистраторKafka' | 'localhost' | '/iTaxi' |
	И Я запоминаю значение выражения 'Строка(Новый УникальныйИдентификатор)' в переменную "ИдентификаторДанных"
	И Я запоминаю значение выражения '"VA-" + Контекст.ИдентификаторДанных' в переменную "КлючЗаписи"
	И Я запоминаю значение выражения 'Контекст.КлючЗаписи + "-3"' в переменную "КлючКонтроля"
	И Я запоминаю значение выражения 'Контекст.КлючЗаписи' в переменную "ИмяДанных"
	И я вывожу значение переменной "КлючЗаписи"
	И я вывожу значение переменной "КлючКонтроля"
	И я вывожу значение переменной "ИдентификаторДанных"
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Если кфкФоновыеОперацииСлужебный.РегламентноеЗадание().Использование
			И Не ПолучитьФункциональнуюОпцию("кфкБлокировкаИнтеграции") Тогда
			ВызватьИсключение "Перед тестом остановите фоновый обмен Kafka.";
		КонецЕсли;
		Если кфкФоновыеОперацииСлужебный.ПолучитьПотоки(СостояниеФоновогоЗадания.Активно).Количество() > 0 Тогда
			ВызватьИсключение "Перед тестом дождитесь завершения фоновых потоков Kafka.";
		КонецЕсли;
		Метка = кфкОбщегоНазначенияСлужебный.НоваяКомбинированнаяМетка();
		МеткаВторая = кфкОбщегоНазначенияСлужебный.НоваяКомбинированнаяМетка();
		Объект.ЗначениеНаСервере = Формат(Метка, "ЧГ=0;ЧН=0") + "|" + Формат(МеткаВторая, "ЧГ=0;ЧН=0");
		"""
	И я выполняю код встроенного языка
		"""bsl
		Метки = СтрРазделить(Ванесса.Объект.ЗначениеНаСервере, "|");
		Контекст.Вставить("МеткаЗаписи", Метки[0]);
		Контекст.Вставить("МеткаВторая", Метки[1]);
		Контекст.Вставить("МеткаЗаписиВФорме", Формат(Число(Метки[0]), "ЧГ=3,0;ЧДЦ=0"));
		Контекст.Вставить("МеткаВтораяВФорме", Формат(Число(Метки[1]), "ЧГ=3,0;ЧДЦ=0"));
		"""

Структура сценария: Карточка показывает метку регистрации или загрузки и независимую метку изменения

	И Я запоминаю значение выражения <ВыражениеВида> в переменную "ВидМетки"
	И Я запоминаю значение выражения <ВыражениеПользователя> в переменную "Пользователь"
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Настройка = кфк_т_ТестовыеДанные.СсылкаПродюсераОбщий();
		Для НомерЗаписи = 1 По 3 Цикл
			Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
			Запись.КлючЗаписи = ?(НомерЗаписи = 3, "$КлючКонтроля$", "$КлючЗаписи$");
			Запись.МеткаРегистрации = Число(?(НомерЗаписи = 2, "$МеткаВторая$", "$МеткаЗаписи$"));
			Запись.МеткаИзменения = Запись.МеткаРегистрации;
			Запись.Статус = Перечисления.кфкСтатусыСообщений.Обработано;
			Запись.Продюсер = Настройка;
			Запись.КлючСообщения = "$КлючЗаписи$-" + Формат(НомерЗаписи, "ЧГ=0");
			Запись.КоличествоОбработок = 3;
			Запись.ДатаОбработки = Дата(2026, 1, 1, 10, 0, 2);
			Запись.ДлОбработкиМС = 125;
			Запись.ТипОбъект = "Справочник.кфк_т_ТестовыйСправочник";
			Запись.ТипИсходныхДанных = "Структура";
			Запись.КлючОбъекта = "$ИдентификаторДанных$";
			Запись.ДатаРегистрации = Дата(2026, 1, 1, 10, 0, 0);
			Запись.КоличествоВыгрузок = 2;
			Запись.ДатаВыгрузки = Дата(2026, 1, 1, 10, 0, 3);
			Запись.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(
				Новый Структура("Маркер", Запись.КлючСообщения));
			Заголовки = Новый Соответствие;
			Заголовки.Вставить("va-marker", Запись.КлючСообщения);
			Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Заголовки);
			Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(
				"{""marker"":""" + Запись.КлючСообщения + """}");
			Запись.ТекстЖурнала = "VA: исходный журнал";
			Если НомерЗаписи = 1 Тогда
				Запись.МеткаИзменения = Число("$МеткаВторая$");
				Если "$ВидМетки$" = "ГраничнаяИсходная" Тогда
					Запись.МеткаРегистрации = кфкОбщегоНазначенияСлужебный.ГраничнаяКомбинированнаяМетка(ТекущаяУниверсальнаяДатаВМиллисекундах());
				ИначеЕсли "$ВидМетки$" = "ГраничнаяИзменения" Тогда
					Запись.МеткаИзменения = кфкОбщегоНазначенияСлужебный.ГраничнаяКомбинированнаяМетка(ТекущаяУниверсальнаяДатаВМиллисекундах());
				КонецЕсли;
			КонецЕсли;
			Если НомерЗаписи = 1 Тогда
				Объект.ЗначениеНаСервере = Формат(Запись.МеткаРегистрации, "ЧГ=0;ЧН=0") + "|" + Формат(Запись.МеткаИзменения, "ЧГ=0;ЧН=0");
			КонецЕсли;
			Запись.Записать();
		КонецЦикла;
		"""
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Метки = СтрРазделить(Объект.ЗначениеНаСервере, "|");
		ИсходнаяМетка = Число(Метки[0]);
		Метка = Число(Метки[1]);
		Значения = Новый Массив;
		Для Каждого ЧислоМетки Из СтрРазделить(Формат(ИсходнаяМетка, "ЧГ=0;ЧН=0") + "|" + Формат(Метка, "ЧГ=0;ЧН=0"), "|") Цикл
			ТекущаяМетка = Число(ЧислоМетки);
			Значения.Добавить(Формат(кфкОбщегоНазначенияСлужебный.МиллисекундыИзКомбинированнойМетки(ТекущаяМетка), "ЧГ=0;ЧН=0"));
			Значения.Добавить(Формат(кфкОбщегоНазначенияСлужебный.НомерСеансаИзКомбинированнойМетки(ТекущаяМетка), "ЧГ=0;ЧН=0"));
			Значения.Добавить(Формат(кфкОбщегоНазначенияСлужебный.СчетчикИзКомбинированнойМетки(ТекущаяМетка), "ЧГ=0;ЧН=0"));
			Значения.Добавить(Формат(кфкОбщегоНазначенияСлужебный.ДатаИзКомбинированнойМетки(ТекущаяМетка), "ДФ='dd.MM.yyyy HH:mm:ss'"));
		КонецЦикла;
		ДатаGMT = кфкОбщегоНазначенияСлужебный.ДатаОтсчетаКомбинированнойМетки()
			+ (кфкОбщегоНазначенияСлужебный.МиллисекундыИзКомбинированнойМетки(Метка)
			- кфкОбщегоНазначенияСлужебный.МоментОтсчетаКомбинированнойМетки()) / 1000;
		Значения.Добавить(Формат(ДатаGMT, "ДФ='dd.MM.yyyy HH:mm:ss'"));
		Объект.ЗначениеНаСервере = СтрСоединить(Значения, "|");
		"""
	И я выполняю код встроенного языка
		"""bsl
		Значения = СтрРазделить(Ванесса.Объект.ЗначениеНаСервере, "|");
		Контекст.Вставить("МС", Формат(Число(Значения[0]), "ЧГ=3,0;ЧДЦ=0;ЧН=0"));
		Контекст.Вставить("Сеанс", Формат(Число(Значения[1]), "ЧГ=3,0;ЧДЦ=0;ЧН=0"));
		Контекст.Вставить("Номер", Формат(Число(Значения[2]), "ЧГ=3,0;ЧДЦ=0;ЧН=0"));
		Контекст.Вставить("Дата", Значения[3]);
		Контекст.Вставить("ИзменениеМС", Формат(Число(Значения[4]), "ЧГ=3,0;ЧДЦ=0;ЧН=0"));
		Контекст.Вставить("ИзменениеСеанс", Формат(Число(Значения[5]), "ЧГ=3,0;ЧДЦ=0;ЧН=0"));
		Контекст.Вставить("ИзменениеНомер", Формат(Число(Значения[6]), "ЧГ=3,0;ЧДЦ=0;ЧН=0"));
		Контекст.Вставить("ИзменениеДата", Значения[7]);
		Контекст.Вставить("ИзменениеGMT", Значения[8]);
		"""
	Дано Я подключаю клиент тестирования с параметрами:
		| 'Имя' | 'Логин' | 'Имя компьютера' | 'Дополнительные параметры строки запуска' |
		| '$Пользователь$' | '$Пользователь$' | 'localhost' | '/iTaxi' |
	И я читаю данные текущего профиля клиента тестирования
	Тогда переменная "ИмяКлиентаТестирования" имеет значение "$Пользователь$"
	И переменная "ДопПараметрыКлиентаТестирования" имеет значение '*/N"$Пользователь$"*' по шаблону
	И переменная "ДопПараметрыКлиентаТестирования" имеет значение "*/iTaxi*" по шаблону
	И Я закрыл все окна клиентского приложения
	И Я открываю навигационную ссылку "e1cib/list/РегистрСведений.кфкИсходящиеСообщения"
	Тогда открылась форма с именем "РегистрСведений.кфкИсходящиеСообщения.Форма.ФормаСписка"
	И Я очищаю фильтр на форме списка
	И в таблице "Список" я перехожу к строке
		| 'Ключ' |
		| '$КлючЗаписи$-1' |
	И в таблице "Список" я выбираю текущую строку
	Тогда открылась форма с именем "РегистрСведений.кфкИсходящиеСообщения.Форма.ФормаЗаписи"
	И я перехожу к закладке с именем "СтраницаСвойства"
	И элемент формы с именем "МеткаРегистрацииМС" стал равен "$МС$"
	И элемент формы с именем "МеткаРегистрацииСеанс" стал равен "$Сеанс$"
	И элемент формы с именем "МеткаРегистрацииНомер" стал равен "$Номер$"
	И элемент формы с именем "МеткаРегистрацииДата" стал равен "$Дата$"
	И элемент формы с именем "МеткаИзмененияМС" стал равен "$ИзменениеМС$"
	И элемент формы с именем "МеткаИзмененияСеанс" стал равен "$ИзменениеСеанс$"
	И элемент формы с именем "МеткаИзмененияНомер" стал равен "$ИзменениеНомер$"
	И элемент формы с именем "МеткаИзмененияДата" стал равен "$ИзменениеДата$"
	И Я закрыл все окна клиентского приложения
	И я активизирую TestClient "АдминистраторKafka"
	И Я закрыл все окна клиентского приложения
	И Я открываю навигационную ссылку "e1cib/list/РегистрСведений.кфкИсходящиеСообщения"
	Тогда открылась форма с именем "РегистрСведений.кфкИсходящиеСообщения.Форма.ФормаСписка"
	И Я очищаю фильтр на форме списка
	И Я устанавливаю фильтр на список
		| 'Ключ записи' | 'Содержит' | '$КлючЗаписи$' |
	Если в таблице "Список" количество строк "больше" 0 Тогда
		И я нажимаю на кнопку с именем "УдалитьОтфильтрованныеСообщения"
		Тогда открылось окно "Удаление сообщений"
		И я нажимаю на кнопку "Да"
		И я жду закрытия формы с именем "ОбщаяФорма.ДлительнаяОперация" в течение 60 секунд
	И я жду, что в таблице "Список" количество строк будет "равно" 0 в течение 30 секунд
	И Я закрыл все окна клиентского приложения
	И Я открываю навигационную ссылку "e1cib/list/РегистрСведений.кфкОчередьПотоков"
	Тогда открылась форма с именем "РегистрСведений.кфкОчередьПотоков.Форма.ФормаСписка"
	И Я очищаю фильтр на форме списка
	И Я устанавливаю фильтр на список
		| 'Ключ' | 'Равно' | '$КлючЗаписи$' |
	Если в таблице "Список" количество строк "больше" 0 Тогда
		И я удаляю все строки таблицы "Список"
		И я нажимаю на кнопку 'Да'
	И я жду, что в таблице "Список" количество строк будет "равно" 0 в течение 30 секунд
	И Я очищаю фильтр на форме списка
	И Я устанавливаю фильтр на список
		| 'Ключ' | 'Равно' | '$КлючКонтроля$' |
	Если в таблице "Список" количество строк "больше" 0 Тогда
		И я удаляю все строки таблицы "Список"
		И я нажимаю на кнопку 'Да'
	И я жду, что в таблице "Список" количество строк будет "равно" 0 в течение 30 секунд
	И Я закрыл все окна клиентского приложения

	Примеры:
		| 'ВыражениеВида' | 'ВыражениеПользователя' |
		| '"Обычная"' | '"АдминистраторKafka"' |
		| '"ГраничнаяИсходная"' | '"АдминистраторKafka"' |
