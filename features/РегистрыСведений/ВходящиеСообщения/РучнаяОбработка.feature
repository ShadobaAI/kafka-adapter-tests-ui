			СтрокаТЧ = Данные.ТабличнаяЧасть.Добавить();
			СтрокаТЧ.ДатаИВремя = Дата(2026, 1, 1, 10, 0, 1);
			СтрокаТЧ.Строка = "$ИмяДанных$-строка";
			Запись = РегистрыСведений.кфкВходящиеСообщения.СоздатьМенеджерЗаписи();
			Запись.КлючЗаписи = "$КлючЗаписи$";
			Запись.МеткаЗагрузки = Число("$МеткаЗаписи$");
			Запись.Прочитать();
			Запись.Консьюмер = кфк_т_ТестовыеДанные.СсылкаКонсьюмераСправочника();
			ДанныеJSON = Новый Структура;
			ДанныеJSON.Вставить("id", "$ИдентификаторДанных$");
			ДанныеJSON.Вставить("deleted", Ложь);
			ДанныеJSON.Вставить("predefinedDataName", "");
			ДанныеJSON.Вставить("name", "$ИмяДанных$");
			ДанныеJSON.Вставить("dateTime", "2026-01-01T10:00:00");
