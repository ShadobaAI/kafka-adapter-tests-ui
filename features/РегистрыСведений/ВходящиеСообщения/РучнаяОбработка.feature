			ДанныеJSON.Вставить("comment", "VA: собственные данные");
			СтрокиТЧ = Новый Массив;
			СтрокиТЧ.Добавить(Новый Структура("dateTime,string", "2026-01-01T10:00:01", "$ИмяДанных$-строка"));
