		| 'ВыражениеИдентификатора' | 'ВыражениеПредставления' |
		| '"00000000-0001-0000-0000-111111111111"' | '"Выгрузка логов исходящих сообщений"' |
		| '"00000000-0001-0000-0000-222222222222"' | '"Выгрузка логов входящих сообщений"' |
		| '"00000000-0002-0000-0000-333333333333"' | '"Контроль интеграции исходящих сообщений"' |
		| '"00000000-0002-0000-0000-444444444444"' | '"Контроль интеграции входящих сообщений"' |
		| '"00000000-0003-0000-0000-666666666666"' | '"Публикация сообщений"' |
		| '"00000000-0003-0000-0000-777777777777"' | '"Удаление дублей очереди"' |
		| '"00000000-0003-0000-0000-999999999999"' | '"Возврат в очередь"' |
		| '"00000000-0003-0000-0000-888888888888"' | '"Десериализация сообщений"' |
		| '"00000000-0004-0000-0001-111111111111"' | '"Изменение настроек"' |

Сценарий: Неизвестная операция в карточке позиции

	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Метка = кфкОбщегоНазначенияСлужебный.НоваяКомбинированнаяМетка();
		Сеанс = Формат(кфкОбщегоНазначенияСлужебный.НомерСеансаИзКомбинированнойМетки(Метка), "ЧГ=0;ЧН=0");
		Номер = Формат(кфкОбщегоНазначенияСлужебный.СчетчикИзКомбинированнойМетки(Метка), "ЧГ=0;ЧН=0");
		ДатаМетки = кфкОбщегоНазначенияСлужебный.ДатаИзКомбинированнойМетки(Метка);
		Объект.ЗначениеНаСервере = Формат(Метка, "ЧГ=0;ЧН=0") + "|" + Сеанс + "|" + Номер
			+ "|" + Формат(ДатаМетки, "ДФ=dd.MM.yyyy H:mm:ss");
		"""
	И я выполняю код встроенного языка
		"""bsl
		ЗначенияМетки = СтрРазделить(Ванесса.Объект.ЗначениеНаСервере, "|", Истина);
		Контекст.Вставить("МеткаЗаписи", ЗначенияМетки[0]);
		Контекст.Вставить("ОжидаемыйСеанс", ЗначенияМетки[1]);
		Контекст.Вставить("ОжидаемыйНомер", ЗначенияМетки[2]);
		Контекст.Вставить("ОжидаемаяДата", ЗначенияМетки[3]);
		"""
	И я вывожу значение переменной "МеткаЗаписи"
