#language: ru

@tree
@СлужебныеРегистры
@ПозицииОпераций

Функциональность: Позиции операций (Kafka) - Представления операций
# Проверяется прикладное представление идентификатора операции в карточке записи.
# Сериализация сообщений уже покрыта в ПросмотрИПрава.feature.
# Ожидания заданы явно, без вызова проверяемой функции ПредставленияИдентификатораОпераций.
# Каждая строка примеров создаёт собственный раздел VA-Регистры-<UUID>.
# Менеджер и TestClient работают в localhost\kafka; метки создаются методами КомбинированныеМетки.
# После успеха и ошибки удаляется только собственная запись; TestClient остаётся открытым.
# При аварийном обрыве выполнить код очистки с выведенными идентификатором операции и ключом раздела.

Контекст:
	И Я запоминаю значение выражения 'Строка(Новый УникальныйИдентификатор)' в переменную "ИдентификаторЗаписи"
	И Я запоминаю значение выражения '"VA-Регистры-" + Контекст.ИдентификаторЗаписи' в переменную "КлючЗаписи"
	И я вывожу значение переменной "КлючЗаписи"
	И я вывожу значение переменной "ИдентификаторЗаписи"

Структура сценария: Представление известной операции в карточке позиции

	И Я запоминаю значение выражения <ВыражениеИдентификатора> в переменную "ОперацияЗаписи"
	И Я запоминаю значение выражения <ВыражениеПредставления> в переменную "ОжидаемоеПредставлениеОперации"
	И я вывожу значение переменной "ОперацияЗаписи"
	И я вывожу значение переменной "ОжидаемоеПредставлениеОперации"
	Попытка
		И я выполняю код встроенного языка на сервере с передачей переменных
			"""bsl
			Запись = РегистрыСведений.кфкПозицииОпераций.СоздатьМенеджерЗаписи();
			Запись.Идентификатор = Новый УникальныйИдентификатор("$ОперацияЗаписи$");
			Запись.Раздел = "$КлючЗаписи$";
			Запись.РазделПредставление = "VA-Раздел операции";
			Запись.КомбинированнаяМетка = кфкОбщегоНазначенияСлужебный.НоваяКомбинированнаяМетка();
			Запись.Записать();
			"""
		Дано Я подключаю клиент тестирования с параметрами:
			| 'Имя' | 'Логин' | 'Имя компьютера' | 'Дополнительные параметры строки запуска' |
			| 'АдминистраторKafka' | 'АдминистраторKafka' | 'localhost' | '/iTaxi' |
		И я читаю данные текущего профиля клиента тестирования
		Тогда переменная "ИмяКлиентаТестирования" имеет значение "АдминистраторKafka"
		И переменная "ДопПараметрыКлиентаТестирования" имеет значение '*/N"АдминистраторKafka"*' по шаблону
		И переменная "ДопПараметрыКлиентаТестирования" имеет значение "*/iTaxi*" по шаблону
		И Я закрыл все окна клиентского приложения
		И Я открываю навигационную ссылку "e1cib/list/РегистрСведений.кфкПозицииОпераций"
		Тогда открылась форма с именем "РегистрСведений.кфкПозицииОпераций.Форма.ФормаСписка"
		И в таблице "Список" я перехожу к строке
			| 'ИД раздела' |
			| '$КлючЗаписи$' |
		И в таблице "Список" я выбираю текущую строку
		Тогда открылась форма с именем "РегистрСведений.кфкПозицииОпераций.Форма.ФормаЗаписи"
		И элемент формы с именем "Идентификатор" стал равен "$ОперацияЗаписи$"
		И элемент формы с именем "ПредставлениеОперации" стал равен "$ОжидаемоеПредставлениеОперации$"
		И элемент формы с именем "Раздел" стал равен "$КлючЗаписи$"
		И элемент формы с именем "РазделПредставление" стал равен "VA-Раздел операции"
		И Я закрыл все окна клиентского приложения
	Исключение
		И я выполняю код встроенного языка на сервере с передачей переменных
			"""bsl
			Запись = РегистрыСведений.кфкПозицииОпераций.СоздатьМенеджерЗаписи();
			Запись.Идентификатор = Новый УникальныйИдентификатор("$ОперацияЗаписи$");
			Запись.Раздел = "$КлючЗаписи$";
			Запись.Удалить();
			"""
		И я регистрирую ошибку "Представление известной операции в карточке позиции" по данным исключения
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
