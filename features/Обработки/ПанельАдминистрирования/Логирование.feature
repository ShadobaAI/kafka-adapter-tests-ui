#language: ru

@tree
@ПанельАдминистрирования
@Логирование

Функциональность: Панель администрирования Kafka - Логирование
# Общая подготовленная ИБ менеджера и TestClient; параллельные прогоны и ручная смена настроек запрещены.
# До подготовки создаётся снимок в хранилище общих настроек ИБ. В отчёт выводится только ключ.
# После аварийного обрыва восстановить этот снимок до следующего запуска.
# Менеджер и оба TestClient остаются открытыми. Потоки и сетевые отправки эти сценарии не запускают.

Контекст:
	Дано Я подключаю клиент тестирования с параметрами:
		| 'Имя' | 'Логин' | 'Имя компьютера' | 'Дополнительные параметры строки запуска' |
		| 'АдминистраторKafka' | 'АдминистраторKafka' | 'localhost' | '/iTaxi' |
	И я читаю данные текущего профиля клиента тестирования
	Тогда переменная "ИмяКлиентаТестирования" имеет значение "АдминистраторKafka"
	И переменная "ДопПараметрыКлиентаТестирования" имеет значение '*/N"АдминистраторKafka"*' по шаблону
	И переменная "ДопПараметрыКлиентаТестирования" имеет значение "*/iTaxi*" по шаблону
	И я запоминаю значение выражения на сервере 'ПользователиИнформационнойБазы.ТекущийПользователь().Имя' в переменную "ФактическийПользовательПанели" (Расширение)
	Тогда переменная "ФактическийПользовательПанели" имеет значение "АдминистраторKafka"
	И Я закрыл все окна клиентского приложения
	И я включаю проверку видимости элементов с учётом видимости групп элементов
	И я включаю проверку доступности элементов с учётом доступности групп элементов
	И я запоминаю значение выражения 'КаталогВременныхФайлов()' в переменную "КаталогДляЛогирования" (Расширение)
	И я выполняю код встроенного языка
		"""bsl
		РазделительПути = ?(Лев(Контекст.КаталогДляЛогирования, 1) = "/", "/", "\");
		Если Прав(Контекст.КаталогДляЛогирования, 1) <> РазделительПути Тогда
		    Контекст.КаталогДляЛогирования = Контекст.КаталогДляЛогирования + РазделительПути;
		КонецЕсли;
		Контекст.Вставить("НедопустимыйКаталогЛогирования", Контекст.КаталогДляЛогирования + "ЖурналKafka");
		Для НомерСимвола = 1 По СтрДлина(Контекст.КаталогДляЛогирования) Цикл
		    КодПроверяемогоСимвола = КодСимвола(Контекст.КаталогДляЛогирования, НомерСимвола);
		    Если КодПроверяемогоСимвола >= 1024 И КодПроверяемогоСимвола <= 1279 Тогда
		        ВызватьИсключение "Для положительной проверки нужен временный каталог TestClient без кириллицы.";
		    КонецЕсли;
		КонецЦикла;
		"""

Сценарий: Сохранение КаталогЛогированияКомпоненты заполненного значения
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Если кфкФоновыеОперацииСлужебный.ПолучитьПотоки(СостояниеФоновогоЗадания.Активно).Количество() > 0 Тогда
		    ВызватьИсключение "Перед проверкой настроек должны завершиться активные потоки Kafka.";
		КонецЕсли;
		Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(
		    Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.кфкЗапускИнтеграции));
		Если Задания.Количество() <> 1 Тогда
		    ВызватьИсключение "Нужно одно заранее созданное регламентное задание Kafka. Подготовка теста его не создаёт.";
		КонецЕсли;
		Задание = Задания[0];
		Снимок = Новый Структура;
		Снимок.Вставить("ИдентификаторЗадания", Задание.УникальныйИдентификатор);
		Снимок.Вставить("Константы", Новый Структура);
		Снимок.Вставить("Регистры", Новый Структура);
		Снимок.Вставить("Задание", Новый Структура);
		Снимок.Константы.Вставить("кфкИспользоватьИнтеграцию", Константы.кфкИспользоватьИнтеграцию.Получить());
		Снимок.Константы.Вставить("кфкБлокировкаИнтеграции", Константы.кфкБлокировкаИнтеграции.Получить());
		Снимок.Константы.Вставить("кфкКаталогЛогированияКомпоненты", Константы.кфкКаталогЛогированияКомпоненты.Получить());
		Снимок.Константы.Вставить("кфкФорматИмениФайловЛогированияКомпоненты", Константы.кфкФорматИмениФайловЛогированияКомпоненты.Получить());
		Набор = РегистрыСведений.кфкПараметрыЛогирования.СоздатьНаборЗаписей();
		Набор.Прочитать();
		Снимок.Регистры.Вставить("кфкПараметрыЛогирования", Набор.Выгрузить());
		Снимок.Задание.Вставить("Использование", Задание.Использование);
		Снимок.Задание.Вставить("Расписание", ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Задание.Расписание));
		// Снимок остаётся в ИБ после завершения сеанса; в переменные Vanessa передаётся только его ключ.
		КлючСнимка = "VA-Панель-" + Строка(Новый УникальныйИдентификатор);
		ХранилищеОбщихНастроек.Сохранить("VA.ПанельАдминистрирования", КлючСнимка, Снимок,, "АдминистраторТакси");
		ПроверкаСнимка = ХранилищеОбщихНастроек.Загрузить("VA.ПанельАдминистрирования", КлючСнимка,, "АдминистраторТакси");
		Если ЗначениеВСтрокуВнутр(ПроверкаСнимка) <> ЗначениеВСтрокуВнутр(Снимок) Тогда
			ВызватьИсключение "Не подтверждена долговременная запись снимка; подготовка остановлена.";
		КонецЕсли;
		Объект.ЗначениеНаСервере = КлючСнимка;
		"""
	И я выполняю код встроенного языка
		"""bsl
		Контекст.Вставить("КлючСнимкаПанели", Ванесса.Объект.ЗначениеНаСервере);
		"""
	И я вывожу значение переменной "КлючСнимкаПанели"
	Попытка
		И я выполняю код встроенного языка на сервере с передачей переменных
			"""bsl
			Снимок = ХранилищеОбщихНастроек.Загрузить("VA.ПанельАдминистрирования", "$КлючСнимкаПанели$",, "АдминистраторТакси");
			Если Снимок = Неопределено Тогда
			    ВызватьИсключение "Снимок настроек не найден; подготовка остановлена.";
			КонецЕсли;
			Задания = РегламентныеЗаданияСервер.НайтиЗадания(
			    Новый Структура("УникальныйИдентификатор", Снимок.ИдентификаторЗадания));
			Если Задания.Количество() <> 1 Тогда
			    ВызватьИсключение "Исходное задание не найдено однозначно; снимок оставлен для восстановления.";
			КонецЕсли;
			Задание = Задания[0];
			Задание.Использование = Ложь;
			Задание.Записать();
			Расписание = ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(Неопределено);
			Расписание.ДатаНачала = Дата(3999, 1, 1);
			Расписание.ДатаКонца = Дата(3999, 1, 1);
			Задание.Расписание = Расписание;
			Задание.Записать();
			Константы.кфкИспользоватьИнтеграцию.Установить(Истина);
			Константы.кфкБлокировкаИнтеграции.Установить(Истина);
			"""
