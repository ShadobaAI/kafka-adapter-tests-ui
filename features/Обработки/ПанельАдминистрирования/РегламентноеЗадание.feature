			КонецЕсли;
			Константы.кфкБлокировкаИнтеграции.Установить(Истина);
			Константы.кфкИспользоватьИнтеграцию.Установить(Истина);
			Задание.Использование = Ложь;
			Задание.Записать();
			ОтборАктивных = Новый Структура("ИмяМетода,Состояние",
			    Задание.Метаданные.ИмяМетода, СостояниеФоновогоЗадания.Активно);
			Если ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборАктивных).Количество() > 0 Тогда
