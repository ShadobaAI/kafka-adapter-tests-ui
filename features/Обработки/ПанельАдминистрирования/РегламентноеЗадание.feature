			    Если Константы[Настройка.Ключ].Получить() <> Настройка.Значение Тогда
			        ВызватьИсключение "Константа изменилась после снимка: " + Настройка.Ключ;
			    КонецЕсли;
			КонецЦикла;
			Если ТекущаяДата() > Снимок.МоментЗапуска + 30 Тогда
			    ВызватьИсключение "Время подготовки истекло; задание не запущено.";
			КонецЕсли;
			Снимок.ИзменениеНачато = Истина;
			ХранилищеОбщихНастроек.Сохранить("VA.ПанельАдминистрирования", "$КлючСнимкаПанели$", Снимок,, "АдминистраторТакси");
