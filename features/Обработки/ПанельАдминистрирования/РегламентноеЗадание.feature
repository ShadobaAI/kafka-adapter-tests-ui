			Расписание.ПериодПовтораВТечениеДня = 0;
			Расписание.ПериодПовтораДней = 1;
			Расписание.ПериодНедель = 1;
			ДниНедели = Новый Массив;
			ДниНедели.Добавить(ДеньНедели(Снимок.МоментЗапуска));
			Расписание.ДниНедели = ДниНедели;
			Месяцы = Новый Массив;
			Месяцы.Добавить(Месяц(Снимок.МоментЗапуска));
			Расписание.Месяцы = Месяцы;
			Задание.Расписание = Расписание;
			Задание.ИмяПользователя = "$ПримерПанелиПользователь$";
			Задание.КоличествоПовторовПриАварийномЗавершении = 0;
			Задание.Записать();
			Если Не Константы.кфкБлокировкаИнтеграции.Получить()
			    Или Не ПолучитьФункциональнуюОпцию("кфкБлокировкаИнтеграции") Тогда
			    ВызватьИсключение "Блокировка интеграции снята; задание не включено.";
			КонецЕсли;
			// Включение записанного задания запускает планировщик.
			Задание.Использование = Истина;
			Задание.Записать();
			"""
		И я делаю 120 раз
			И Пауза 1
			И я выполняю код встроенного языка на сервере с передачей переменных
				"""bsl
				Снимок = ХранилищеОбщихНастроек.Загрузить("VA.ПанельАдминистрирования", "$КлючСнимкаПанели$",, "АдминистраторТакси");
				Если Снимок = Неопределено Тогда
				    ВызватьИсключение "Снимок не найден во время ожидания.";
				КонецЕсли;
				Если Не Константы.кфкБлокировкаИнтеграции.Получить() Тогда
				    ВызватьИсключение "Блокировка интеграции снята во время ожидания.";
				КонецЕсли;
				Задания = РегламентныеЗаданияСервер.НайтиЗадания(
				    Новый Структура("УникальныйИдентификатор", Снимок.ИдентификаторЗадания));
				Если Задания.Количество() <> 1 Тогда
				    ВызватьИсключение "Исходное задание не найдено однозначно.";
				КонецЕсли;
				Последнее = Задания[0].ПоследнееЗадание;
				Результат = Новый Структура("Готово,Успех,Состояние,Идентификатор", Ложь, Ложь, "", "");
				Если Последнее <> Неопределено Тогда
				    ИдентификаторПоследнего = Строка(Последнее.УникальныйИдентификатор);
				    Если ИдентификаторПоследнего <> Снимок.ИдентификаторПоследнегоДо
				        И Последнее.Начало >= Снимок.МоментЗапуска - 5 Тогда
				        Если Последнее.РегламентноеЗадание = Неопределено
				            Или Последнее.РегламентноеЗадание.УникальныйИдентификатор <> Снимок.ИдентификаторЗадания Тогда
				            ВызватьИсключение "Последнее выполнение относится к другому заданию.";
				        КонецЕсли;
				        Результат.Состояние = Строка(Последнее.Состояние);
				        Результат.Идентификатор = ИдентификаторПоследнего;
				        Результат.Готово = Последнее.Состояние <> СостояниеФоновогоЗадания.Активно;
				        Результат.Успех = Последнее.Состояние = СостояниеФоновогоЗадания.Завершено;
