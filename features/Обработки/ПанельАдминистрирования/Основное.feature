				| '$КлючНавигации$' |
		Если выражение внутреннего языка '"$ПримерПанелиКоманда$" = "РСВходящиеСообщения"' Истинно Тогда
			И Я очищаю фильтр на форме списка
			И таблица "Список" содержит строки:
				| 'Ключ' |
				| '$КлючНавигации$' |
		Если выражение внутреннего языка '"$ПримерПанелиКоманда$" = "РСОчередьПотоков"' Истинно Тогда
			И Я очищаю фильтр на форме списка
			И таблица "Список" содержит строки:
				| 'Ключ' |
				| '$КлючНавигации$' |
		Если выражение внутреннего языка '"$ПримерПанелиКоманда$" = "РСПозицииОпераций"' Истинно Тогда
			И Я очищаю фильтр на форме списка
			И таблица "Список" содержит строки:
				| 'ИД раздела' |
				| '$КлючНавигации$' |
