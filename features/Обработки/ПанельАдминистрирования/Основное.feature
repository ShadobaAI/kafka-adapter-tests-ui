Структура сценария: Прикладная ссылка открывает соответствующий объект
	И я запоминаю строку <Команда> в переменную "ПримерПанелиКоманда"
	И я запоминаю строку <Форма> в переменную "ПримерПанелиФорма"
	И Я запоминаю значение выражения '"VA-Панель-" + Строка(Новый УникальныйИдентификатор)' в переменную "КлючНавигации"
	И я вывожу значение переменной "КлючНавигации"
	И Я сохраняю настройки панели Kafka для раздела "Основное"
	Попытка
		И Я подготавливаю безопасный режим панели Kafka
		И я выполняю код встроенного языка на сервере с передачей переменных
			"""bsl
			Метка = кфкОбщегоНазначенияСлужебный.НоваяКомбинированнаяМетка();
			Если "$ПримерПанелиКоманда$" = "РСИсходящиеСообщения" Тогда
				Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
				Запись.КлючЗаписи = "$КлючНавигации$";
				Запись.КлючСообщения = "$КлючНавигации$";
				Запись.МеткаРегистрации = Метка;
				Запись.МеткаИзменения = Метка;
				Запись.Статус = Перечисления.кфкСтатусыСообщений.Выгружено;
				Запись.Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераОбщий();
				Запись.КлючОбъекта = "$КлючНавигации$";
				Запись.ДатаРегистрации = Дата(2026, 1, 1);
				Запись.Записать();
			ИначеЕсли "$ПримерПанелиКоманда$" = "РСВходящиеСообщения" Тогда
				Запись = РегистрыСведений.кфкВходящиеСообщения.СоздатьМенеджерЗаписи();
				Запись.КлючЗаписи = "$КлючНавигации$";
				Запись.КлючСообщения = "$КлючНавигации$";
				Запись.МеткаЗагрузки = Метка;
				Запись.МеткаИзменения = Метка;
				Запись.Статус = Перечисления.кфкСтатусыСообщений.ОшибкаОбработки;
				Запись.Консьюмер = кфк_т_ТестовыеДанные.СсылкаКонсьюмераОбщий();
				Запись.ДатаЗаписи = Дата(2026, 1, 1);
				Запись.ДатаЗагрузки = Дата(2026, 1, 1);
				Запись.Записать();
			ИначеЕсли "$ПримерПанелиКоманда$" = "РСОчередьПотоков" Тогда
				Запись = РегистрыСведений.кфкОчередьПотоков.СоздатьМенеджерЗаписи();
				Запись.Ключ = "$КлючНавигации$";
				Запись.ИдентификаторПотока = Новый УникальныйИдентификатор;
				Запись.КомбинированнаяМетка = Метка;
				Запись.Записать();
			ИначеЕсли "$ПримерПанелиКоманда$" = "РСПозицииОпераций" Тогда
				Запись = РегистрыСведений.кфкПозицииОпераций.СоздатьМенеджерЗаписи();
				Запись.Идентификатор = Новый УникальныйИдентификатор("00000000-0003-0000-0000-555555555555");
				Запись.Раздел = "$КлючНавигации$";
				Запись.РазделПредставление = "$КлючНавигации$";
				Запись.КомбинированнаяМетка = Метка;
				Запись.Записать();
			КонецЕсли;
			"""
		И Я закрыл все окна клиентского приложения
		И Я открываю навигационную ссылку "e1cib/app/Обработка.кфкПанельАдминистрирования"
