@ПанельАдминистрирования
@Основное

Функциональность: Панель администрирования Kafka - Основное
# Общая подготовленная ИБ менеджера и TestClient; параллельные прогоны и ручная смена настроек запрещены.
# До подготовки создаётся снимок в хранилище общих настроек ИБ. В отчёт выводится только ключ.
# После аварийного обрыва восстановить этот снимок до следующего запуска.
# Менеджер и оба TestClient остаются открытыми. Потоки и сетевые отправки эти сценарии не запускают.

Контекст:
	Дано Я подключаю клиент тестирования с параметрами:
		| 'Имя' | 'Логин' | 'Имя компьютера' | 'Дополнительные параметры строки запуска' |
		| 'АдминистраторKafka' | 'АдминистраторKafka' | 'localhost' | '/iTaxi' |
	И я читаю данные текущего профиля клиента тестирования
	Тогда переменная "ИмяКлиентаТестирования" имеет значение "АдминистраторKafka"
	И переменная "ДопПараметрыКлиентаТестирования" имеет значение '*/N"АдминистраторKafka"*' по шаблону
	И переменная "ДопПараметрыКлиентаТестирования" имеет значение "*/iTaxi*" по шаблону
	И я запоминаю значение выражения на сервере 'ПользователиИнформационнойБазы.ТекущийПользователь().Имя' в переменную "ФактическийПользовательПанели" (Расширение)
	Тогда переменная "ФактическийПользовательПанели" имеет значение "АдминистраторKafka"
	И Я закрыл все окна клиентского приложения
	И я включаю проверку видимости элементов с учётом видимости групп элементов
	И я включаю проверку доступности элементов с учётом доступности групп элементов

Структура сценария: Оба размещения команды открывают заданную страницу
	И я запоминаю строку <Команда> в переменную "ПримерПанелиКоманда"
	И я запоминаю строку <Страница> в переменную "ПримерПанелиСтраница"
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Если кфкФоновыеОперацииСлужебный.ПолучитьПотоки(СостояниеФоновогоЗадания.Активно).Количество() > 0 Тогда
		    ВызватьИсключение "Перед проверкой настроек должны завершиться активные потоки Kafka.";
		КонецЕсли;
		Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(
		    Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.кфкЗапускИнтеграции));
		Если Задания.Количество() <> 1 Тогда
		    ВызватьИсключение "Нужно одно заранее созданное регламентное задание Kafka. Подготовка теста его не создаёт.";
		КонецЕсли;
		Задание = Задания[0];
		Снимок = Новый Структура;
		Снимок.Вставить("ИдентификаторЗадания", Задание.УникальныйИдентификатор);
		Снимок.Вставить("Константы", Новый Структура);
		Снимок.Вставить("Регистры", Новый Структура);
		Снимок.Вставить("Задание", Новый Структура);
		Снимок.Константы.Вставить("кфкИспользоватьИнтеграцию", Константы.кфкИспользоватьИнтеграцию.Получить());
		Снимок.Константы.Вставить("кфкБлокировкаИнтеграции", Константы.кфкБлокировкаИнтеграции.Получить());
		Снимок.Задание.Вставить("Использование", Задание.Использование);
		Снимок.Задание.Вставить("Расписание", ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Задание.Расписание));
		// Снимок остаётся в ИБ после завершения сеанса; в переменные Vanessa передаётся только его ключ.
		КлючСнимка = "VA-Панель-" + Строка(Новый УникальныйИдентификатор);
		ХранилищеОбщихНастроек.Сохранить("VA.ПанельАдминистрирования", КлючСнимка, Снимок,, "АдминистраторТакси");
		ПроверкаСнимка = ХранилищеОбщихНастроек.Загрузить("VA.ПанельАдминистрирования", КлючСнимка,, "АдминистраторТакси");
		Если ЗначениеВСтрокуВнутр(ПроверкаСнимка) <> ЗначениеВСтрокуВнутр(Снимок) Тогда
			ВызватьИсключение "Не подтверждена долговременная запись снимка; подготовка остановлена.";
		КонецЕсли;
		Объект.ЗначениеНаСервере = КлючСнимка;
		"""
	И я выполняю код встроенного языка
		"""bsl
		Контекст.Вставить("КлючСнимкаПанели", Ванесса.Объект.ЗначениеНаСервере);
		"""
	И я вывожу значение переменной "КлючСнимкаПанели"
	Попытка
		И я выполняю код встроенного языка на сервере с передачей переменных
			"""bsl
			Снимок = ХранилищеОбщихНастроек.Загрузить("VA.ПанельАдминистрирования", "$КлючСнимкаПанели$",, "АдминистраторТакси");
			Если Снимок = Неопределено Тогда
			    ВызватьИсключение "Снимок настроек не найден; подготовка остановлена.";
			КонецЕсли;
			Задания = РегламентныеЗаданияСервер.НайтиЗадания(
			    Новый Структура("УникальныйИдентификатор", Снимок.ИдентификаторЗадания));
			Если Задания.Количество() <> 1 Тогда
			    ВызватьИсключение "Исходное задание не найдено однозначно; снимок оставлен для восстановления.";
			КонецЕсли;
			Задание = Задания[0];
			Задание.Использование = Ложь;
			Задание.Записать();
			Расписание = ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(Неопределено);
			Расписание.ДатаНачала = Дата(3999, 1, 1);
			Расписание.ДатаКонца = Дата(3999, 1, 1);
			Задание.Расписание = Расписание;
			Задание.Записать();
			Константы.кфкИспользоватьИнтеграцию.Установить(Истина);
			Константы.кфкБлокировкаИнтеграции.Установить(Истина);
			"""
		И я выполняю код встроенного языка на сервере с передачей переменных
			"""bsl
			Очистка = РегистрыСведений.кфкПараметрыОчисткиХранилища.ПолучитьПараметры();
			Лог = РегистрыСведений.кфкПараметрыЛогирования.ПолучитьПараметры();
			Объект.ЗначениеНаСервере = Новый Структура("Срок,Префикс,Наименование",
			    Очистка.СрокХраненияОтправленных, Лог.Префикс,
			    кфкФоновыеОперацииСлужебный.РегламентноеЗадание().Наименование);
			"""
		И я выполняю код встроенного языка
			"""bsl
			Контекст.Вставить("ОжидаемыйСрокПанели", Формат(Ванесса.Объект.ЗначениеНаСервере.Срок, "ЧГ=0"));
			Контекст.Вставить("ОжидаемыйПрефиксПанели", Ванесса.Объект.ЗначениеНаСервере.Префикс);
			Контекст.Вставить("ОжидаемоеИмяЗадания", Ванесса.Объект.ЗначениеНаСервере.Наименование);
			"""
		И Я закрыл все окна клиентского приложения
		И Я открываю навигационную ссылку "e1cib/app/Обработка.кфкПанельАдминистрирования"
		Тогда открылась форма с именем "Обработка.кфкПанельАдминистрирования.Форма.Форма"
		И я выключаю проверку доступности элементов с учётом доступности групп элементов
		И элемент формы с именем "$ПримерПанелиКоманда$" доступен
		И я включаю проверку доступности элементов с учётом доступности групп элементов
		И я нажимаю на кнопку с именем "$ПримерПанелиКоманда$"
		Тогда открылась форма с именем "Обработка.кфкПанельАдминистрирования.Форма.$ПримерПанелиСтраница$"
		Если выражение внутреннего языка '"$ПримерПанелиСтраница$" = "ФоновыеЗадания"' Истинно Тогда
			И я запоминаю значение текущего окна '_ТекущееОкно.БлокировкаИнтеграции' в переменную "ПроверкаФормы" (Расширение)
			Тогда переменная "ПроверкаФормы" имеет значение "Да"
			И элемент формы с именем "Запустить" не доступен
		Если выражение внутреннего языка '"$ПримерПанелиСтраница$" = "РегламентноеЗадание"' Истинно Тогда
			И у элемента формы с именем "ИспользоватьРегламентноеЗадание" не установлена пометка
			Тогда элемент формы с именем "Наименование" стал равен "$ОжидаемоеИмяЗадания$"
		Если выражение внутреннего языка '"$ПримерПанелиСтраница$" = "Очереди"' Истинно Тогда
			Тогда элемент формы с именем "ПараметрыОчисткиХранилищаСрокХраненияОтправленных" стал равен "$ОжидаемыйСрокПанели$"
		Если выражение внутреннего языка '"$ПримерПанелиСтраница$" = "Логирование"' Истинно Тогда
			Тогда элемент формы с именем "ПараметрыЛогированияПрефикс" стал равен "$ОжидаемыйПрефиксПанели$"
		И я запоминаю значение текущего окна '_ТекущееОкно.ИспользоватьИнтеграцию' в переменную "ПроверкаФормы" (Расширение)
		Тогда переменная "ПроверкаФормы" имеет значение "Да"
		И я нажимаю на кнопку с именем "ПерейтиОсновное"
		Тогда открылась форма с именем "Обработка.кфкПанельАдминистрирования.Форма.Форма"
	Исключение
		И я регистрирую ошибку "Оба размещения команды открывают заданную страницу" по данным исключения
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Снимок = ХранилищеОбщихНастроек.Загрузить("VA.ПанельАдминистрирования", "$КлючСнимкаПанели$",, "АдминистраторТакси");
		Если Снимок = Неопределено Тогда
		    ВызватьИсключение "Снимок настроек не найден; восстановление остановлено.";
		КонецЕсли;
		Задания = РегламентныеЗаданияСервер.НайтиЗадания(
		    Новый Структура("УникальныйИдентификатор", Снимок.ИдентификаторЗадания));
		Если Задания.Количество() <> 1 Тогда
		    ВызватьИсключение "Исходное задание не найдено однозначно; снимок оставлен для восстановления.";
		КонецЕсли;
		Задание = Задания[0];
		Если Задание = Неопределено Тогда
		    ВызватьИсключение "Исходное регламентное задание исчезло; снимок оставлен для восстановления.";
		КонецЕсли;
		Задание.Использование = Ложь;
		Задание.Записать();
		Для Каждого Регистр Из Снимок.Регистры Цикл
		    Набор = РегистрыСведений[Регистр.Ключ].СоздатьНаборЗаписей();
		    Набор.Загрузить(Регистр.Значение);
		    Набор.Записать();
		    Набор.Прочитать();
		    Если ЗначениеВСтрокуВнутр(Набор.Выгрузить()) <> ЗначениеВСтрокуВнутр(Регистр.Значение) Тогда
		        ВызватьИсключение "Не восстановлен регистр " + Регистр.Ключ;
		    КонецЕсли;
		КонецЦикла;
		Для Каждого Настройка Из Снимок.Константы Цикл
		    Константы[Настройка.Ключ].Установить(Настройка.Значение);
		    Если Константы[Настройка.Ключ].Получить() <> Настройка.Значение Тогда
		        ВызватьИсключение "Не восстановлена константа " + Настройка.Ключ;
		    КонецЕсли;
		КонецЦикла;
		Для Каждого Свойство Из Снимок.Задание Цикл
		    Если Свойство.Ключ <> "Использование" Тогда
		        Задание[Свойство.Ключ] = ?(Свойство.Ключ = "Расписание",
		            ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(Свойство.Значение), Свойство.Значение);
		    КонецЕсли;
		КонецЦикла;
		Задание.Использование = Снимок.Задание.Использование;
		Задание.Записать();
		Задания = РегламентныеЗаданияСервер.НайтиЗадания(
		    Новый Структура("УникальныйИдентификатор", Снимок.ИдентификаторЗадания));
		Если Задания.Количество() <> 1 Тогда
		    ВызватьИсключение "Исходное задание не найдено однозначно; снимок оставлен для восстановления.";
		КонецЕсли;
		Задание = Задания[0];
		Для Каждого Свойство Из Снимок.Задание Цикл
		    Проверка = ?(Свойство.Ключ = "Расписание",
		        ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Задание.Расписание), Задание[Свойство.Ключ]);
		    Если ЗначениеВСтрокуВнутр(Проверка) <> ЗначениеВСтрокуВнутр(Свойство.Значение) Тогда
		        ВызватьИсключение "Не восстановлено свойство задания " + Свойство.Ключ;
		    КонецЕсли;
		КонецЦикла;
		// Снимок сохраняется после проверки для аудита и восстановления после аварии.
		"""

	Примеры:
		| 'Команда' | 'Страница' |
		| 'ПерейтиФоновыеЗадания' | 'ФоновыеЗадания' |
		| 'ПерейтиФоновыеЗаданияИзОсновной' | 'ФоновыеЗадания' |
		| 'ПерейтиРегламентноеЗадание' | 'РегламентноеЗадание' |
		| 'ПерейтиРегламентноеЗаданиеИзОсновной' | 'РегламентноеЗадание' |
		| 'ПерейтиОчереди' | 'Очереди' |
		| 'ПерейтиОчередиИзОсновной' | 'Очереди' |
		| 'ПерейтиЛогирование' | 'Логирование' |
		| 'ПерейтиЛогированиеИзОсновной' | 'Логирование' |

Структура сценария: Переход между дочерними страницами сохраняет владельца
	И я запоминаю строку <Источник> в переменную "ПримерПанелиИсточник"
	И я запоминаю строку <Назначение> в переменную "ПримерПанелиНазначение"
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Если кфкФоновыеОперацииСлужебный.ПолучитьПотоки(СостояниеФоновогоЗадания.Активно).Количество() > 0 Тогда
