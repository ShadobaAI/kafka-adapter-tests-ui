Функциональность: Очистка собственных продюсеров UI-тестов Kafka

Сценарий: Я удаляю тестового продюсера Kafka "ИмяПродюсера" "СсылкаПродюсера"
	И я выполняю код встроенного языка на сервере
		"""bsl
		Имя = "[ИмяПродюсера]";
		Префикс = "VA-Продюсеры-";
		ПрефиксИерархии = "VA-Иерархия-Продюсеры-";
		ПрефиксНепустых = "VA-Непустые-Продюсеры-";
		Если Лев(Имя, СтрДлина(Префикс)) <> Префикс
			И Лев(Имя, СтрДлина(ПрефиксИерархии)) <> ПрефиксИерархии
			И Лев(Имя, СтрДлина(ПрефиксНепустых)) <> ПрефиксНепустых Тогда
			ВызватьИсключение "Недопустимое имя тестового продюсера; очистка остановлена.";
		КонецЕсли;

		Продюсер = Справочники.кфкПродюсеры.НайтиПоНаименованию(Имя, Истина);
		Если Не Продюсер.Пустая() Тогда
			Если Продюсер.ЭтоГруппа Тогда
				ВызватьИсключение "Найденный объект является диспетчером; очистка остановлена.";
			КонецЕсли;
			Если "[СсылкаПродюсера]" <> ""
				И ПолучитьНавигационнуюСсылку(Продюсер) <> "[СсылкаПродюсера]" Тогда
				ВызватьИсключение "Ссылка тестового продюсера не совпадает; очистка остановлена.";
			КонецЕсли;

			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 КлючЗаписи ИЗ РегистрСведений.кфкИсходящиеСообщения ГДЕ Продюсер = &Продюсер";
			Запрос.УстановитьПараметр("Продюсер", Продюсер);
			Если Не Запрос.Выполнить().Пустой() Тогда
				ВызватьИсключение "У тестового продюсера есть исходящие сообщения; очистка остановлена.";
			КонецЕсли;

			ОбъектПродюсера = Продюсер.ПолучитьОбъект();
			ОбъектПродюсера.ДополнительныеСвойства.Вставить("кфкПропуститьРегистрацию", Истина);
			ОбъектПродюсера.Удалить();
			ОбновитьПовторноИспользуемыеЗначения();
		КонецЕсли;
		"""

Сценарий: Я удаляю продюсера без имени тестового брокера Kafka "ИмяБрокера" "СсылкаБрокера"
	И я выполняю код встроенного языка на сервере
		"""bsl
		Имя = "[ИмяБрокера]";
		Если Лев(Имя, 11) <> "VA-Брокеры-" Тогда
			ВызватьИсключение "Недопустимое имя тестового брокера; очистка остановлена.";
		КонецЕсли;
		Брокер = Справочники.кфкБрокеры.НайтиПоНаименованию(Имя, Истина);
		Если Не Брокер.Пустая() Тогда
			Если "[СсылкаБрокера]" = ""
				Или ПолучитьНавигационнуюСсылку(Брокер) <> "[СсылкаБрокера]" Тогда
				ВызватьИсключение "Ссылка тестового брокера не подтверждена; очистка остановлена.";
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.кфкПродюсеры ГДЕ Брокер = &Брокер И Наименование = &Имя";
			Запрос.УстановитьПараметр("Брокер", Брокер);
			Запрос.УстановитьПараметр("Имя", "");
			НайденныеПродюсеры = Запрос.Выполнить().Выгрузить();
			Если НайденныеПродюсеры.Количество() > 1 Тогда
				ВызватьИсключение "Найдено несколько продюсеров без имени; очистка остановлена.";
			КонецЕсли;
			Если НайденныеПродюсеры.Количество() = 1 Тогда
				Продюсер = НайденныеПродюсеры[0].Ссылка;
				Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 КлючЗаписи ИЗ РегистрСведений.кфкИсходящиеСообщения ГДЕ Продюсер = &Продюсер";
				Запрос.УстановитьПараметр("Продюсер", Продюсер);
				Если Не Запрос.Выполнить().Пустой() Тогда
					ВызватьИсключение "У продюсера без имени есть исходящие сообщения; очистка остановлена.";
				КонецЕсли;
				ОбъектПродюсера = Продюсер.ПолучитьОбъект();
				ОбъектПродюсера.ДополнительныеСвойства.Вставить("кфкПропуститьРегистрацию", Истина);
				ОбъектПродюсера.Удалить();
				ОбновитьПовторноИспользуемыеЗначения();
			КонецЕсли;
		КонецЕсли;
		"""
