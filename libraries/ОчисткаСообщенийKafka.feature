Функциональность: Очистка данных сценариев сообщений Kafka

Сценарий: Я удаляю тестовые сообщения Kafka "ИмяРегистра" "ИдентификаторДанных" "КлючЗаписи"
	И я выполняю код встроенного языка на сервере
		"""bsl
		Идентификатор = Новый УникальныйИдентификатор("[ИдентификаторДанных]");
		БазовыйКлюч = "VA-" + Строка(Идентификатор);
		Ключ = "[КлючЗаписи]";
		Если "[ИмяРегистра]" = "кфкИсходящиеСообщения" Тогда
			Менеджер = РегистрыСведений.кфкИсходящиеСообщения;
			Если Ключ <> БазовыйКлюч Тогда
				Ссылка = Справочники.кфк_т_ТестовыйСправочник.ПолучитьСсылку(Идентификатор);
				КлючиОбъекта = кфкОбработкаСобытийСлужебный.КлючЗаписиИсходящихСообщений(Ссылка);
				Если КлючиОбъекта = Неопределено Или КлючиОбъекта.Найти(Ключ) = Неопределено Тогда
					ВызватьИсключение "Ключ исходящих сообщений не принадлежит тестовому объекту.";
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли "[ИмяРегистра]" = "кфкВходящиеСообщения" Тогда
			Менеджер = РегистрыСведений.кфкВходящиеСообщения;
			Если Ключ <> БазовыйКлюч Тогда
				ВызватьИсключение "Ключ входящих сообщений не принадлежит тестовому объекту.";
			КонецЕсли;
		Иначе
			ВызватьИсключение "Неизвестный регистр сообщений.";
		КонецЕсли;
		Для Каждого ТекущийКлюч Из СтрРазделить(Ключ + "," + БазовыйКлюч + "-3", ",") Цикл
			Сообщения = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(Менеджер);
			Сообщения.Отбор.КлючЗаписи.Установить(ТекущийКлюч);
			Сообщения.Записать();
			Очередь = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкОчередьПотоков);
			Очередь.Отбор.Ключ.Установить(ТекущийКлюч);
			Очередь.Записать();
		КонецЦикла;
		"""

Сценарий: Я удаляю тестовый объект сообщений Kafka "ИдентификаторДанных"
	И я выполняю код встроенного языка на сервере
		"""bsl
		Идентификатор = Новый УникальныйИдентификатор("[ИдентификаторДанных]");
		Ссылка = Справочники.кфк_т_ТестовыйСправочник.ПолучитьСсылку(Идентификатор);
		Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			Данные = Ссылка.ПолучитьОбъект();
			Если Данные.Наименование <> "VA-" + Строка(Идентификатор) Тогда
				ВызватьИсключение "Имя тестового объекта сообщений изменилось; очистка остановлена.";
			КонецЕсли;
			кфкИнтеграция.Отключить(Данные);
			Данные.ОбменДанными.Загрузка = Истина;
			Данные.Удалить();
		КонецЕсли;
		"""

Сценарий: Я выключаю временное регламентное задание сообщений Kafka
	И я выполняю код встроенного языка на сервере
		"""bsl
		Задание = кфкФоновыеОперацииСлужебный.РегламентноеЗадание();
		Задание.Использование = Ложь;
		Задание.Записать();
		"""

Сценарий: Я восстанавливаю режим фонового обмена сообщений Kafka
	И я выполняю код встроенного языка
		"""bsl
		Ванесса.Объект.ЗначениеНаСервере = Контекст.ИсходноеСостояниеФоновогоОбмена;
		"""
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Состояние = ЗначениеИзСтрокиВнутр(Объект.ЗначениеНаСервере);
		Задание = кфкФоновыеОперацииСлужебный.РегламентноеЗадание();
		Задание.Использование = Ложь;
		Задание.Записать();
		Константы.кфкБлокировкаИнтеграции.Установить(Состояние.БлокировкаИнтеграции);
		Задание.Расписание = ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(Состояние.Расписание);
		Задание.Использование = Состояние.Использование;
		Задание.Записать();
		Проверка = кфкФоновыеОперацииСлужебный.РегламентноеЗадание();
		Если Проверка.Использование <> Состояние.Использование
			Или Константы.кфкБлокировкаИнтеграции.Получить() <> Состояние.БлокировкаИнтеграции
			Или ЗначениеВСтрокуВнутр(ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Проверка.Расписание))
				<> ЗначениеВСтрокуВнутр(Состояние.Расписание) Тогда
			ВызватьИсключение "Не удалось восстановить исходный режим фонового обмена Kafka.";
		КонецЕсли;
		"""
