@ExportScenarios
Функциональность: Фикстуры сообщений UI-тестов Kafka

Сценарий: Я подготавливаю тестовые исходящие сообщения Kafka "КлючЗаписи" "МеткаЗаписи" "МеткаВторая" "ИдентификаторДанных" "Статус"
	И я выполняю код встроенного языка на сервере
		"""bsl
		Настройка = кфк_т_ТестовыеДанные.СсылкаПродюсераОбщий();
		ИмяСтатуса = "[Статус]";
		Для НомерЗаписи = 1 По 3 Цикл
			Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
			Запись.КлючЗаписи = ?(НомерЗаписи = 3, "[КлючЗаписи]-3", "[КлючЗаписи]");
			Запись.МеткаРегистрации = Число(?(НомерЗаписи = 2, "[МеткаВторая]", "[МеткаЗаписи]"));
			Запись.МеткаИзменения = Запись.МеткаРегистрации;
			Запись.Статус = Перечисления.кфкСтатусыСообщений[ИмяСтатуса];
			Запись.Продюсер = Настройка;
			Запись.КлючСообщения = "[КлючЗаписи]-" + Формат(НомерЗаписи, "ЧГ=0");
			Запись.КоличествоОбработок = 3;
			Запись.ДатаОбработки = Дата(2026, 1, 1, 10, 0, 2);
			Запись.ДлОбработкиМС = 125;
			Запись.ТипОбъект = "Справочник.кфк_т_ТестовыйСправочник";
			Запись.ТипИсходныхДанных = "Структура";
			Запись.КлючОбъекта = "[ИдентификаторДанных]";
			Запись.ДатаРегистрации = Дата(2026, 1, 1, 10, 0, НомерЗаписи);
			Запись.КоличествоВыгрузок = 2;
			Запись.ДатаВыгрузки = Дата(2026, 1, 1, 10, 0, 3);
			Запись.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(
				Новый Структура("Маркер", Запись.КлючСообщения));
			Заголовки = Новый Соответствие;
			Заголовки.Вставить("va-marker", Запись.КлючСообщения);
			Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Заголовки);
			Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(
				"{""marker"":""" + Запись.КлючСообщения + """}");
			Запись.ТекстЖурнала = "VA: исходный журнал";
			Запись.Записать();
		КонецЦикла;
		"""

Сценарий: Я подготавливаю тестовые входящие сообщения Kafka "КлючЗаписи" "МеткаЗаписи" "МеткаВторая" "Статус"
	И я выполняю код встроенного языка на сервере
		"""bsl
		Настройка = кфк_т_ТестовыеДанные.СсылкаКонсьюмераОбщий();
		ИмяСтатуса = "[Статус]";
		Для НомерЗаписи = 1 По 3 Цикл
			Запись = РегистрыСведений.кфкВходящиеСообщения.СоздатьМенеджерЗаписи();
			Запись.КлючЗаписи = ?(НомерЗаписи = 3, "[КлючЗаписи]-3", "[КлючЗаписи]");
			Запись.МеткаЗагрузки = Число(?(НомерЗаписи = 2, "[МеткаВторая]", "[МеткаЗаписи]"));
			Запись.МеткаИзменения = Запись.МеткаЗагрузки;
			Запись.Статус = Перечисления.кфкСтатусыСообщений[ИмяСтатуса];
			Запись.Консьюмер = Настройка;
			Запись.КлючСообщения = "[КлючЗаписи]-" + Формат(НомерЗаписи, "ЧГ=0");
			Запись.КоличествоОбработок = 3;
			Запись.ДатаОбработки = Дата(2026, 1, 1, 10, 0, 2);
			Запись.ДлОбработкиМС = 125;
			Запись.Топик = "1c.test-catalogs";
			Запись.Раздел = 2;
			Запись.Смещение = 40 + НомерЗаписи;
			Запись.ДатаЗаписи = Дата(2026, 1, 1, 10, 0, 0);
			Запись.ДатаЗагрузки = Дата(2026, 1, 1, 10, 0, 1);
			Заголовки = Новый Соответствие;
			Заголовки.Вставить("va-marker", Запись.КлючСообщения);
			Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Заголовки);
			Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(
				"{""marker"":""" + Запись.КлючСообщения + """}");
			Запись.ТекстЖурнала = "VA: исходный журнал";
			Запись.Записать();
		КонецЦикла;
		"""
