Функциональность: Общие шаги восстановления настроек панели Kafka

Сценарий: Я восстанавливаю настройки панели Kafka
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Снимок = ХранилищеОбщихНастроек.Загрузить("VA.ПанельАдминистрирования", "$КлючСнимкаПанели$",, "АдминистраторТакси");
		Если Снимок = Неопределено Тогда
		    ВызватьИсключение "Снимок настроек не найден; восстановление остановлено.";
		КонецЕсли;
		Задания = РегламентныеЗаданияСервер.НайтиЗадания(
		    Новый Структура("УникальныйИдентификатор", Снимок.ИдентификаторЗадания));
		Если Задания.Количество() <> 1 Тогда
		    ВызватьИсключение "Исходное задание не найдено однозначно; снимок оставлен для восстановления.";
		КонецЕсли;
		Задание = Задания[0];
		Если Задание = Неопределено Тогда
		    ВызватьИсключение "Исходное регламентное задание исчезло; снимок оставлен для восстановления.";
		КонецЕсли;
		Задание.Использование = Ложь;
		Задание.Записать();
		Для Каждого Регистр Из Снимок.Регистры Цикл
		    Набор = РегистрыСведений[Регистр.Ключ].СоздатьНаборЗаписей();
		    Набор.Загрузить(Регистр.Значение);
		    Набор.Записать();
		    Набор.Прочитать();
		    Если ЗначениеВСтрокуВнутр(Набор.Выгрузить()) <> ЗначениеВСтрокуВнутр(Регистр.Значение) Тогда
		        ВызватьИсключение "Не восстановлен регистр " + Регистр.Ключ;
		    КонецЕсли;
		КонецЦикла;
		Для Каждого Настройка Из Снимок.Константы Цикл
		    Константы[Настройка.Ключ].Установить(Настройка.Значение);
		    Если Константы[Настройка.Ключ].Получить() <> Настройка.Значение Тогда
		        ВызватьИсключение "Не восстановлена константа " + Настройка.Ключ;
		    КонецЕсли;
		КонецЦикла;
		Для Каждого Свойство Из Снимок.Задание Цикл
		    Если Свойство.Ключ <> "Использование" Тогда
		        Задание[Свойство.Ключ] = ?(Свойство.Ключ = "Расписание",
		            ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(Свойство.Значение), Свойство.Значение);
		    КонецЕсли;
		КонецЦикла;
		Задание.Использование = Снимок.Задание.Использование;
		Задание.Записать();
		Задания = РегламентныеЗаданияСервер.НайтиЗадания(
		    Новый Структура("УникальныйИдентификатор", Снимок.ИдентификаторЗадания));
		Если Задания.Количество() <> 1 Тогда
		    ВызватьИсключение "Исходное задание не найдено однозначно; снимок оставлен для восстановления.";
		КонецЕсли;
		Задание = Задания[0];
		Для Каждого Свойство Из Снимок.Задание Цикл
		    Проверка = ?(Свойство.Ключ = "Расписание",
		        ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Задание.Расписание), Задание[Свойство.Ключ]);
		    Если ЗначениеВСтрокуВнутр(Проверка) <> ЗначениеВСтрокуВнутр(Свойство.Значение) Тогда
		        ВызватьИсключение "Не восстановлено свойство задания " + Свойство.Ключ;
		    КонецЕсли;
		КонецЦикла;
		// Снимок сохраняется после проверки для аудита и восстановления после аварии.
		"""

Сценарий: Я восстанавливаю настройки панели Kafka со структурным сравнением
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Снимок = ХранилищеОбщихНастроек.Загрузить("VA.ПанельАдминистрирования", "$КлючСнимкаПанели$",, "АдминистраторТакси");
