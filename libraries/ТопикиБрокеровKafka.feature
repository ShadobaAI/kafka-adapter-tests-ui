@ExportScenarios
Функциональность: Детерминированный список топиков в UI Kafka

# Кеш принадлежит сеансу TestClient. Подготовка в менеджере не влияет на форму клиента.
# Повторять перед выбором брокера и открытием записанной карточки: запись настроек сбрасывает кеш.
# Проверки алгоритма кеширования принадлежат YAxUnit, здесь задаётся только внешняя граница Kafka.
Сценарий: Я синхронно подготавливаю топики брокера Kafka "НаименованиеБрокера" "СписокТопиков"

	И Я запоминаю в переменную "КодПодготовкиТопиковKafka" значение
		"""bsl
		Брокер = Справочники.кфкБрокеры.НайтиПоНаименованию("[НаименованиеБрокера]", Истина);
		Если Брокер.Пустая() Тогда
			ВызватьИсключение "Не найден брокер для подготовки списка топиков: [НаименованиеБрокера]";
		КонецЕсли;
		Топики = СтрРазделить("[СписокТопиков]", ",", Ложь);
		кфкИнтеграцияСлужебныйВызовСервера.ОбновитьКЭШДоступныхТопиков(Брокер, Топики);
		ЗначениеДляВозврата = "готово";
		"""
	И я запоминаю значение выражения на сервере '$КодПодготовкиТопиковKafka$' в переменную "РезультатПодготовкиТопиковKafka" (Расширение)
	Тогда переменная "РезультатПодготовкиТопиковKafka" имеет значение "готово"

Сценарий: Я синхронно очищаю кеш топиков тестового брокера Kafka "НаименованиеБрокера"

	И Я запоминаю в переменную "КодОчисткиТопиковKafka" значение
		"""bsl
		Если Лев("[НаименованиеБрокера]", 11) <> "VA-Брокеры-" Тогда
			ВызватьИсключение "Недопустимое имя тестового брокера; очистка кеша остановлена.";
		КонецЕсли;
		Брокер = Справочники.кфкБрокеры.НайтиПоНаименованию("[НаименованиеБрокера]", Истина);
		Если Не Брокер.Пустая() Тогда
			Кеш = кфкИнтеграцияСлужебныйПовтИсп.ДоступныеТопики();
			Кеш.Удалить(Брокер);
		КонецЕсли;
		ЗначениеДляВозврата = "готово";
		"""
	И я запоминаю значение выражения на сервере '$КодОчисткиТопиковKafka$' в переменную "РезультатОчисткиТопиковKafka" (Расширение)
	Тогда переменная "РезультатОчисткиТопиковKafka" имеет значение "готово"

Сценарий: Я сохраняю снимок кеша топиков брокера Kafka "НаименованиеБрокера"
	И Я запоминаю в переменную "КодСнимкаТопиковKafka" значение
		"""bsl
		Брокер = Справочники.кфкБрокеры.НайтиПоНаименованию("[НаименованиеБрокера]", Истина);
		Если Брокер.Пустая() Тогда
			ВызватьИсключение "Не найден брокер для сохранения кеша: [НаименованиеБрокера]";
		КонецЕсли;
		Топики = кфкИнтеграцияСлужебныйПовтИсп.ДоступныеТопики().Получить(Брокер);
		Если Топики <> Неопределено Тогда
			Топики = Новый Массив(Топики);
		КонецЕсли;
		Снимок = Новый Структура("Брокер,Топики", Брокер, Топики);
		ЗначениеДляВозврата = ПоместитьВоВременноеХранилище(Снимок, Новый УникальныйИдентификатор);
		"""
	И я запоминаю значение выражения на сервере '$КодСнимкаТопиковKafka$' в переменную "АдресСнимкаТопиковKafka" (Расширение)

Сценарий: Я восстанавливаю снимок кеша топиков брокера Kafka "НаименованиеБрокера" "АдресСнимка"
	И Я запоминаю в переменную "КодВосстановленияТопиковKafka" значение
		"""bsl
		Если "[АдресСнимка]" <> "" Тогда
			Брокер = Справочники.кфкБрокеры.НайтиПоНаименованию("[НаименованиеБрокера]", Истина);
			Снимок = ПолучитьИзВременногоХранилища("[АдресСнимка]");
			Если Брокер.Пустая() Или ТипЗнч(Снимок) <> Тип("Структура") Или Снимок.Брокер <> Брокер Тогда
				ВызватьИсключение "Не удалось подтвердить исходный кеш брокера; восстановление остановлено.";
			КонецЕсли;
			Кеш = кфкИнтеграцияСлужебныйПовтИсп.ДоступныеТопики();
			Если Снимок.Топики = Неопределено Тогда
				Кеш.Удалить(Брокер);
			Иначе
				Кеш.Вставить(Брокер, Новый ФиксированныйМассив(Снимок.Топики));
			КонецЕсли;
			УдалитьИзВременногоХранилища("[АдресСнимка]");
		КонецЕсли;
		ЗначениеДляВозврата = "готово";
		"""
	И я запоминаю значение выражения на сервере '$КодВосстановленияТопиковKafka$' в переменную "РезультатВосстановленияТопиковKafka" (Расширение)
	Тогда переменная "РезультатВосстановленияТопиковKafka" имеет значение "готово"
