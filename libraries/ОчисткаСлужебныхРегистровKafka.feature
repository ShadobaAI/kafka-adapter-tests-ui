Функциональность: Очистка собственных записей служебных регистров UI-тестов Kafka

Сценарий: Я удаляю тестовую запись служебного регистра Kafka "ИмяРегистра" "КлючЗаписи" "ИдентификаторЗаписи"
	И я выполняю код встроенного языка на сервере
		"""bsl
		Идентификатор = Новый УникальныйИдентификатор("[ИдентификаторЗаписи]");
		Ключ = "[КлючЗаписи]";
		Если Ключ <> "VA-Регистры-" + Строка(Идентификатор) Тогда
			ВызватьИсключение "Ключ тестовой записи не подтверждён; очистка остановлена.";
		КонецЕсли;
		Если "[ИмяРегистра]" = "кфкОчередьПотоков" Тогда
			Набор = РегистрыСведений.кфкОчередьПотоков.СоздатьНаборЗаписей();
			Набор.Отбор.Ключ.Установить(Ключ);
			Набор.Отбор.ИдентификаторПотока.Установить(Идентификатор);
		ИначеЕсли "[ИмяРегистра]" = "кфкПозицииОпераций" Тогда
			Набор = РегистрыСведений.кфкПозицииОпераций.СоздатьНаборЗаписей();
			Набор.Отбор.Раздел.Установить(Ключ);
		ИначеЕсли "[ИмяРегистра]" = "кфкХэшСуммыСообщений" Тогда
			Набор = РегистрыСведений.кфкХэшСуммыСообщений.СоздатьНаборЗаписей();
			Набор.Отбор.КлючЗаписи.Установить(Ключ);
		Иначе
			ВызватьИсключение "Неизвестный служебный регистр; очистка остановлена.";
		КонецЕсли;
		Набор.Прочитать();
		Если Набор.Количество() > 0 Тогда
			Набор.Очистить();
			Набор.Записать();
		КонецЕсли;
		"""
