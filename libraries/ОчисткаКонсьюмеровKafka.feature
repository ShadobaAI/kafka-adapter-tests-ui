Функциональность: Очистка собственных консьюмеров UI-тестов Kafka

Сценарий: Я удаляю тестового консьюмера Kafka "ИмяКонсьюмера" "СсылкаКонсьюмера"
	И я выполняю код встроенного языка на сервере
		"""bsl
		Имя = "[ИмяКонсьюмера]";
		Префикс = "VA-Консьюмеры-";
		ПрефиксИерархии = "VA-Иерархия-Консьюмеры-";
		ПрефиксНепустых = "VA-Непустые-Консьюмеры-";
		Если Лев(Имя, СтрДлина(Префикс)) <> Префикс
			И Лев(Имя, СтрДлина(ПрефиксИерархии)) <> ПрефиксИерархии
			И Лев(Имя, СтрДлина(ПрефиксНепустых)) <> ПрефиксНепустых Тогда
			ВызватьИсключение "Недопустимое имя тестового консьюмера; очистка остановлена.";
		КонецЕсли;
		Консьюмер = Справочники.кфкКонсьюмеры.НайтиПоНаименованию(Имя, Истина);
		Если Не Консьюмер.Пустая() Тогда
			Если Консьюмер.ЭтоГруппа Тогда
				ВызватьИсключение "Найденный объект является диспетчером; очистка остановлена.";
			КонецЕсли;
			Если "[СсылкаКонсьюмера]" <> ""
				И ПолучитьНавигационнуюСсылку(Консьюмер) <> "[СсылкаКонсьюмера]" Тогда
				ВызватьИсключение "Ссылка тестового консьюмера не совпадает; очистка остановлена.";
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 КлючЗаписи ИЗ РегистрСведений.кфкВходящиеСообщения ГДЕ Консьюмер = &Консьюмер";
			Запрос.УстановитьПараметр("Консьюмер", Консьюмер);
			Если Не Запрос.Выполнить().Пустой() Тогда
				ВызватьИсключение "У тестового консьюмера есть входящие сообщения; очистка остановлена.";
			КонецЕсли;
			ОбъектКонсьюмера = Консьюмер.ПолучитьОбъект();
			ОбъектКонсьюмера.ДополнительныеСвойства.Вставить("кфкПропуститьРегистрацию", Истина);
			ОбъектКонсьюмера.Удалить();
			ОбновитьПовторноИспользуемыеЗначения();
		КонецЕсли;
		"""

Сценарий: Я удаляю консьюмера без имени тестового брокера Kafka "ИмяБрокера" "СсылкаБрокера"
	И я выполняю код встроенного языка на сервере
		"""bsl
		Имя = "[ИмяБрокера]";
		Если Лев(Имя, 11) <> "VA-Брокеры-" Тогда
			ВызватьИсключение "Недопустимое имя тестового брокера; очистка остановлена.";
		КонецЕсли;
		Брокер = Справочники.кфкБрокеры.НайтиПоНаименованию(Имя, Истина);
		Если Не Брокер.Пустая() Тогда
			Если "[СсылкаБрокера]" = ""
				Или ПолучитьНавигационнуюСсылку(Брокер) <> "[СсылкаБрокера]" Тогда
				ВызватьИсключение "Ссылка тестового брокера не подтверждена; очистка остановлена.";
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.кфкКонсьюмеры ГДЕ Брокер = &Брокер И Наименование = &Имя";
			Запрос.УстановитьПараметр("Брокер", Брокер);
			Запрос.УстановитьПараметр("Имя", "");
			НайденныеКонсьюмеры = Запрос.Выполнить().Выгрузить();
			Если НайденныеКонсьюмеры.Количество() > 1 Тогда
				ВызватьИсключение "Найдено несколько консьюмеров без имени; очистка остановлена.";
			КонецЕсли;
			Если НайденныеКонсьюмеры.Количество() = 1 Тогда
				Консьюмер = НайденныеКонсьюмеры[0].Ссылка;
				Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 КлючЗаписи ИЗ РегистрСведений.кфкВходящиеСообщения ГДЕ Консьюмер = &Консьюмер";
				Запрос.УстановитьПараметр("Консьюмер", Консьюмер);
				Если Не Запрос.Выполнить().Пустой() Тогда
					ВызватьИсключение "У консьюмера без имени есть входящие сообщения; очистка остановлена.";
				КонецЕсли;
				ОбъектКонсьюмера = Консьюмер.ПолучитьОбъект();
				ОбъектКонсьюмера.ДополнительныеСвойства.Вставить("кфкПропуститьРегистрацию", Истина);
				ОбъектКонсьюмера.Удалить();
				ОбновитьПовторноИспользуемыеЗначения();
			КонецЕсли;
		КонецЕсли;
		"""
