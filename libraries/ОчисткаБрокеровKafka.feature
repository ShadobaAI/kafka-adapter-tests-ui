Функциональность: Очистка собственных брокеров UI-тестов Kafka

Сценарий: Я удаляю тестового брокера Kafka "ИмяБрокера" "СсылкаБрокера"
	И я выполняю код встроенного языка на сервере
		"""bsl
		Имя = "[ИмяБрокера]";
		Если Лев(Имя, 11) <> "VA-Брокеры-" Тогда
			ВызватьИсключение "Недопустимое имя тестового брокера; очистка остановлена.";
		КонецЕсли;

		Брокер = Справочники.кфкБрокеры.НайтиПоНаименованию(Имя, Истина);
		Если Не Брокер.Пустая() Тогда

			Ссылка = ПолучитьНавигационнуюСсылку(Брокер);
			Если "[СсылкаБрокера]" <> "" И Ссылка <> "[СсылкаБрокера]" Тогда
				ВызватьИсключение "Ссылка тестового брокера не совпадает; очистка остановлена.";
			КонецЕсли;

			ОбъектБрокера = Брокер.ПолучитьОбъект();
			ОбъектБрокера.ДополнительныеСвойства.Вставить("кфкПропуститьРегистрацию", Истина);
			ОбъектБрокера.Удалить();

		КонецЕсли;
		"""
