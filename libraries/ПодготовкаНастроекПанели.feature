@tree
@ExportScenarios
Функциональность: Снимок и безопасная подготовка настроек панели Kafka

Сценарий: Я сохраняю настройки панели Kafka для раздела "Раздел"
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Если кфкФоновыеОперацииСлужебный.ПолучитьПотоки(СостояниеФоновогоЗадания.Активно).Количество() > 0 Тогда
			ВызватьИсключение "Перед проверкой настроек должны завершиться активные потоки Kafka.";
		КонецЕсли;
		Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(
			Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.кфкЗапускИнтеграции));
		Если Задания.Количество() <> 1 Тогда
			ВызватьИсключение "Нужно одно заранее созданное регламентное задание Kafka.";
		КонецЕсли;
		Задание = Задания[0];
		Отбор = Новый Структура("ИмяМетода,Состояние", Задание.Метаданные.ИмяМетода, СостояниеФоновогоЗадания.Активно);
		Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0 Тогда
			ВызватьИсключение "Перед проверкой должно завершиться регламентное задание Kafka.";
		КонецЕсли;
		Если Задание.Использование
			И (Не Константы.кфкБлокировкаИнтеграции.Получить() Или Не ПолучитьФункциональнуюОпцию("кфкБлокировкаИнтеграции"))
			И Задание.Расписание.ДатаНачала <= КонецДня(ТекущаяДата()) Тогда
			ВызватьИсключение "Остановите фоновый обмен или установите безопасное будущее расписание Kafka.";
		КонецЕсли;
		Снимок = Новый Структура;
		Снимок.Вставить("ИдентификаторЗадания", Задание.УникальныйИдентификатор);
		Снимок.Вставить("Константы", Новый Структура);
		Снимок.Вставить("Регистры", Новый Структура);
		Снимок.Вставить("Задание", Новый Структура);
		Снимок.Константы.Вставить("кфкИспользоватьИнтеграцию", Константы.кфкИспользоватьИнтеграцию.Получить());
		Снимок.Константы.Вставить("кфкБлокировкаИнтеграции", Константы.кфкБлокировкаИнтеграции.Получить());
		РазделПанели = "[Раздел]";
		Если РазделПанели = "Логирование" Тогда
			Снимок.Константы.Вставить("кфкКаталогЛогированияКомпоненты", Константы.кфкКаталогЛогированияКомпоненты.Получить());
			Снимок.Константы.Вставить("кфкФорматИмениФайловЛогированияКомпоненты", Константы.кфкФорматИмениФайловЛогированияКомпоненты.Получить());
			Набор = РегистрыСведений.кфкПараметрыЛогирования.СоздатьНаборЗаписей();
			Набор.Прочитать();
			Снимок.Регистры.Вставить("кфкПараметрыЛогирования", Набор.Выгрузить());
		ИначеЕсли РазделПанели = "Очереди" Тогда
			Снимок.Константы.Вставить("кфкИспользоватьКонтрольИнтеграции", Константы.кфкИспользоватьКонтрольИнтеграции.Получить());
			Для Каждого ИмяРегистра Из СтрРазделить("кфкПараметрыОчисткиХранилища,кфкПараметрыКонтроляИнтеграции", ",") Цикл
				Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
				Набор.Прочитать();
				Снимок.Регистры.Вставить(ИмяРегистра, Набор.Выгрузить());
			КонецЦикла;
		ИначеЕсли РазделПанели = "РегламентноеЗадание" Тогда
			Снимок.Задание.Вставить("Наименование", Задание.Наименование);
			Снимок.Задание.Вставить("ИмяПользователя", Задание.ИмяПользователя);
			Снимок.Задание.Вставить("КоличествоПовторовПриАварийномЗавершении", Задание.КоличествоПовторовПриАварийномЗавершении);
			Снимок.Задание.Вставить("ИнтервалПовтораПриАварийномЗавершении", Задание.ИнтервалПовтораПриАварийномЗавершении);
		ИначеЕсли РазделПанели = "ФоновыеЗадания" Тогда
			Снимок.Константы.Вставить("кфкИспользоватьПотоковыйРежим", Константы.кфкИспользоватьПотоковыйРежим.Получить());
		ИначеЕсли РазделПанели <> "Основное" Тогда
			ВызватьИсключение "Неизвестный раздел панели для снимка: " + РазделПанели;
		КонецЕсли;
		Снимок.Задание.Вставить("Использование", Задание.Использование);
		Снимок.Задание.Вставить("Расписание", ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Задание.Расписание));
		КлючСнимка = "VA-Панель-" + Строка(Новый УникальныйИдентификатор);
		ХранилищеОбщихНастроек.Сохранить("VA.ПанельАдминистрирования", КлючСнимка, Снимок,, "АдминистраторТакси");
		ПроверкаСнимка = ХранилищеОбщихНастроек.Загрузить("VA.ПанельАдминистрирования", КлючСнимка,, "АдминистраторТакси");
		Если Не ЮТСравнениеСлужебныйКлиентСервер.ЗначенияРавны(ПроверкаСнимка, Снимок) Тогда
			ВызватьИсключение "Не подтверждена запись снимка; подготовка остановлена.";
		КонецЕсли;
		Объект.ЗначениеНаСервере = КлючСнимка;
		"""
	И я выполняю код встроенного языка
		"""bsl
		Контекст.Вставить("КлючСнимкаПанели", Ванесса.Объект.ЗначениеНаСервере);
		"""
	И я вывожу значение переменной "КлючСнимкаПанели"

Сценарий: Я подготавливаю безопасный режим панели Kafka
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Снимок = ХранилищеОбщихНастроек.Загрузить("VA.ПанельАдминистрирования", "$КлючСнимкаПанели$",, "АдминистраторТакси");
		Если Снимок = Неопределено Тогда
			ВызватьИсключение "Снимок настроек не найден; подготовка остановлена.";
		КонецЕсли;
		Задания = РегламентныеЗаданияСервер.НайтиЗадания(
			Новый Структура("УникальныйИдентификатор", Снимок.ИдентификаторЗадания));
		Если Задания.Количество() <> 1 Тогда
			ВызватьИсключение "Исходное задание не найдено однозначно; снимок оставлен для восстановления.";
		КонецЕсли;
		Задание = Задания[0];
		Задание.Использование = Ложь;
		Задание.Записать();
		Расписание = ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(Неопределено);
		Расписание.ДатаНачала = Дата(3999, 1, 1);
		Расписание.ДатаКонца = Дата(3999, 1, 1);
		Задание.Расписание = Расписание;
		Задание.Записать();
		Константы.кфкБлокировкаИнтеграции.Установить(Истина);
		Константы.кфкИспользоватьИнтеграцию.Установить(Истина);
		"""

Сценарий: Я удаляю восстановленный снимок панели Kafka
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		ХранилищеОбщихНастроек.Удалить("VA.ПанельАдминистрирования", "$КлючСнимкаПанели$", "АдминистраторТакси");
		"""

Сценарий: Я подготавливаю параметры очередей панели Kafka
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Запись = РегистрыСведений.кфкПараметрыОчисткиХранилища.СоздатьМенеджерЗаписи();
		Запись.Прочитать();
		Запись.СрокХраненияОтмененныхИсходящих = 31;
		Запись.СрокХраненияОтправленных = 32;
		Запись.СрокХраненияОшибкиОбработкиИсходящих = 33;
		Запись.СрокХраненияОшибкиОтправки = 34;
		Запись.СрокХраненияОтмененныхВходящих = 35;
		Запись.СрокХраненияОбработанных = 36;
		Запись.СрокХраненияОшибкиОбработкиВходящих = 37;
		Запись.СрокХраненияНезавершенных = 38;
		Запись.СрокХраненияХэшСуммыСообщений = 39;
		Запись.Записать();
		Запись = РегистрыСведений.кфкПараметрыКонтроляИнтеграции.СоздатьМенеджерЗаписи();
		Запись.Прочитать();
		Запись.ВремяSLAИсходящих = 11;
		Запись.ВремяSLAВходящих = 22;
		Запись.ИдентификаторЧатаТГ = "VA-chat-original";
		Запись.ТокенБотаТГ = "VA-synthetic-token-original";
		Запись.Записать();
		Константы.кфкИспользоватьКонтрольИнтеграции.Установить(Ложь);
		"""
