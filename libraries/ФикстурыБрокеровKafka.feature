Функциональность: Собственные брокеры для UI-тестов Kafka

Сценарий: Я создаю тестового брокера Kafka "ИмяБрокера"
	И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		Имя = "[ИмяБрокера]";
		Если Лев(Имя, 11) <> "VA-Брокеры-" Тогда
			ВызватьИсключение "Недопустимое имя тестового брокера.";
		КонецЕсли;
		Если Не Справочники.кфкБрокеры.НайтиПоНаименованию(Имя, Истина).Пустая() Тогда
			ВызватьИсключение "Тестовый брокер с таким именем уже существует.";
		КонецЕсли;

		ОбъектБрокера = Справочники.кфкБрокеры.СоздатьЭлемент();
		ОбъектБрокера.Наименование = Имя;
		Узел = ОбъектБрокера.Узлы.Добавить();
		Узел.Использование = Истина;
		Узел.Адрес = "broker-ui.invalid:9092";
		ОбъектБрокера.ДополнительныеСвойства.Вставить("кфкПропуститьРегистрацию", Истина);
		ОбъектБрокера.Записать();
		Контекст.Вставить("СсылкаБрокера", ПолучитьНавигационнуюСсылку(ОбъектБрокера.Ссылка));
		"""
