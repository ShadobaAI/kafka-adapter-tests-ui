Функциональность: Очистка собственных диспетчеров продюсеров UI-тестов Kafka

Сценарий: Я удаляю тестового диспетчера продюсеров Kafka "ИмяДиспетчера" "СсылкаДиспетчера"
	И я выполняю код встроенного языка на сервере
		"""bsl
		Имя = "[ИмяДиспетчера]";
		Префикс = "VA-Диспетчеры-Продюсеры-";
		ПрефиксИерархии = "VA-Иерархия-Продюсеры-";
		ПрефиксНепустых = "VA-Непустые-Продюсеры-";
		Если Лев(Имя, СтрДлина(Префикс)) <> Префикс
			И Лев(Имя, СтрДлина(ПрефиксИерархии)) <> ПрефиксИерархии
			И Лев(Имя, СтрДлина(ПрефиксНепустых)) <> ПрефиксНепустых Тогда
			ВызватьИсключение "Недопустимое имя тестового диспетчера; очистка остановлена.";
		КонецЕсли;

		Диспетчер = Справочники.кфкПродюсеры.НайтиПоНаименованию(Имя, Истина);
		Если Не Диспетчер.Пустая() Тогда
			Если Не Диспетчер.ЭтоГруппа Тогда
				ВызватьИсключение "Найденный объект не является диспетчером; очистка остановлена.";
			КонецЕсли;
			Если "[СсылкаДиспетчера]" <> ""
				И ПолучитьНавигационнуюСсылку(Диспетчер) <> "[СсылкаДиспетчера]" Тогда
				ВызватьИсключение "Ссылка тестового диспетчера не совпадает; очистка остановлена.";
			КонецЕсли;

			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.кфкПродюсеры ГДЕ Родитель = &Родитель";
			Запрос.УстановитьПараметр("Родитель", Диспетчер);
			Если Не Запрос.Выполнить().Пустой() Тогда
				ВызватьИсключение "У тестового диспетчера есть дочерние элементы; очистка остановлена.";
			КонецЕсли;

			ОбъектДиспетчера = Диспетчер.ПолучитьОбъект();
			ОбъектДиспетчера.ДополнительныеСвойства.Вставить("кфкПропуститьРегистрацию", Истина);
			ОбъектДиспетчера.Удалить();
			ОбновитьПовторноИспользуемыеЗначения();
		КонецЕсли;
		"""
